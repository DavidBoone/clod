#!/bin/bash
# clod: run Claude Code, Codex or a shell in a throwaway Docker container on the
# current directory. `clod --help` describes the commands and options.
#
# clod refuses to mount your home directory, a directory above it, ~/.clod or
# anything under ~/.clod/homes as /workspace, since the agent could then read
# your credentials and every home's login.
#
# Launcher settings come from the command line (-i, -H, -P) or else the calling
# shell's environment:
#
#   CLOD_HOME   container home: a name (~/.clod/homes/<name>), a host path
#               relative to the current directory if it contains a slash, or
#               vol:<name> for the Docker volume clod-home-<name> (default: default)
#   CLOD_IMAGE  image to run (default clod): a variant name, built from
#               ~/.clod/images/<name>/ or else this script's images/<name>/ as
#               clod-<name>; variants combined as a+b, b built on a as clod-a.b;
#               or any local docker image
#   CLOD_COMMAND  command a bare `clod` (or `clod -- ARGS`) runs: claude
#               (default), codex, bash or zsh
#   CLOD_PORTS  ports to publish on the host's 127.0.0.1, comma- or
#               space-separated: 8080 (the same on both sides), host:container,
#               or address:host:container to publish on another address
#
# The .envrc (below) can set these too, as defaults for the shell's, and
# ~/.clod/config (NAME=value lines, written by `clod default KEY VALUE`) as
# defaults for both. A setting set empty, by an option or the shell, still
# overrides them.
#
# The clod image is built from this script's directory, and a variant from its
# directory, whenever their files (or, for a variant, an image it is FROM, in
# any stage) change. A variant can build on another as FROM clod-<name>, or
# declare ARG BASE=clod and build FROM $BASE, so a combination a+b can pass it
# --build-arg BASE=clod-a.
#
# ~/.clod/shared is mounted read-only as /etc/claude-code, where Claude Code
# reads managed settings and CLAUDE.md for every home. Until you create it, the
# starter set in this script's shared/ directory is mounted instead. What Claude
# is told about the container comes with the image, from container.md.
#
# /workspace is the current directory, or with -w another directory or, as
# vol:NAME, the Docker volume clod-workspace-NAME. It is an option only: the
# workspace is the project, so no setting picks it. `clod workspace` lists the
# volume workspaces and `clod workspace rm` deletes them; `clod home rm` deletes
# homes. Both ask first in a terminal, and need --force without one.
#
# Inside the container, CLOD_HOME, CLOD_WORKSPACE and CLOD_IMAGE hold the home
# and workspace labels and image tag this run resolved to, and CLOD_PORTS the
# published container ports. With --docker, CLOD_HOST_WORKSPACE is the workspace directory's path on the host.
# With --scratch, CLOD_SCRATCH is set and /workspace is an empty volume.
#
# On a Linux host the clod image's claude user is built with the host user's
# uid and gid, and host.docker.internal is mapped to the host.
#
# The nearest .envrc, looking up from the workspace directory, is loaded on the
# host by direnv, so it must be allowed, and the variables it exports are passed
# into the container. Launcher settings it sets are used, not passed in.
#
# --docker mounts the Docker socket, which is root on the Docker host (on macOS,
# the VM, with your home folder mounted). It is an option only, with no setting
# in the environment, envrc or config, so a project can't turn it on.
#
# --scratch mounts nothing at /workspace: it is an empty volume, discarded with
# the container. No envrc is read, since the current directory isn't the
# project, and nothing is refused there, since nothing there is mounted. A
# vol:NAME workspace is the same, except that the volume is kept.

# Written for bash 3.2, the /bin/bash macOS ships.
#
# Below are the helpers, the setup phases and the commands (cmd_* functions);
# the dispatch at the bottom runs the phases a command needs, then the command.
# Commands are a single word (env, default, the run commands) or a noun with a
# verb (image, home, workspace, shared); a bare noun lists, except shared, which
# needs a verb. A new command or noun goes in `commands`, a new verb in its
# noun's list in noun_verbs, and either in the usage, a cmd_ function and the
# dispatch; a new option in parse_args, the usage and `options`; a new launcher
# setting in `settings`. Tab completion reads those lists.
#
# Helpers return a value in REPLY, plus named globals when there are more, so
# callers needn't fork a subshell. Those whose result is text print it instead:
# text for output, a list read line by line, or a hash from a pipeline. Those
# described as "true when" return a status.

# This script's directory, found by following symlinks to it (macOS readlink
# has no -f before 12.3), holds the base image's files, the bundled variants
# and the starter shared config.
script=$0
while [[ -L $script ]]; do
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
script_dir=$(cd "$(dirname "$script")" && pwd -P)
base_dir=$script_dir
[[ -f $base_dir/Dockerfile ]] || base_dir=

# The commands, the ones among them that run in the container, and the nouns,
# whose verbs noun_verbs lists.
run_commands='claude codex bash zsh'
nouns='image home workspace shared'
commands="$run_commands env $nouns default update install completion"
# Commands that stand for image's verbs, left out of the usage and completion.
alias_commands='build rebuild'

# Sets REPLY to the verbs of noun $1.
noun_verbs() {
  case $1 in
    image) REPLY='show new build rebuild rm prune' ;;
    home) REPLY='cp mv rm' ;;
    workspace) REPLY='rm' ;;
    shared) REPLY='new diff' ;;
  esac
}
# The long options parse_args takes, for tab completion.
options='--image --home --workspace --port --scratch --force --skip-build --docker --help --version'

# The launcher settings, as KEY:VARIABLE:BUILT-IN (- for none), in the order
# clod default lists them.
settings='image:CLOD_IMAGE:clod command:CLOD_COMMAND:claude home:CLOD_HOME:default
  ports:CLOD_PORTS:-'

name_re='^[A-Za-z0-9_-]+$'
port_re='^((([0-9.]+|\[[0-9a-fA-F:]+\]):)?[0-9]+:)?[0-9]+(/(tcp|udp))?$'
clod_dir=$HOME/.clod
config=$clod_dir/config
command -v shasum >/dev/null && sum=shasum || sum=sha1sum

# Docker Engine on Linux keeps bind-mount ownership as is, so claude gets the
# host user's ids there.
base_args=()
[[ $OSTYPE == linux* ]] &&
  base_args=(--build-arg "CLOD_UID=$(id -u)" --build-arg "CLOD_GID=$(id -g)")

# Prints clod's version: its checkout's commit, or a tag when there is one.
clod_version() {
  git -C "$script_dir" describe --tags --always --dirty 2>/dev/null || echo unknown
}

usage() {
  cat <<'USAGE'
Usage: clod [options] [command] [args...]

Runs an agent or a shell in a throwaway container on the current directory.

Commands:
  claude [args]          Claude Code
  codex [args]           Codex
  bash|zsh [args]        a shell in the container
  env                    show the home, image, ports, .envrc and variables
  default [KEY [VALUE]]  show or set your defaults: image, command, home,
                         ports (VALUE --reset removes one)
  update                 update clod itself (git pull in its checkout)
  install [DIR]          link clod into DIR, or a directory on your PATH
  completion             print tab completion for bash and zsh, to load from
                         your shell's startup file: eval "$(clod completion)"

  image                  list the base image, the variants and the images clod
                         built, and which are stale or in use
  image show NAME        show how image NAME is built: the images it is FROM
  image new NAME [FROM]  create ~/.clod/images/NAME as a copy of variant FROM,
                         a starter on combination FROM (A+B), a copy of the
                         bundled variant NAME, or a starter
  image build [NAME...]  build images and their bases where they're stale, or
                         the one -i names
  image rebuild [NAME...]
                         rebuild images and their bases from scratch, or the
                         one -i names
  image rm [NAME...]     remove images clod built, or the one -i names; a
                         variant's files stay, and its next run builds it again
  image prune            remove the stale images clod built, which their next
                         run would rebuild anyway

  home                   list the homes and their logins
  home cp SRC DEST       copy home SRC to a new home DEST: a name, a path or
                         vol:NAME, so a directory home can become a volume one
                         or the other way round
  home mv SRC DEST       move home SRC to a new home DEST, as cp then deleting
                         SRC; a directory home moved to a directory is renamed
  home rm NAME...        delete homes, logins included: names (in
                         ~/.clod/homes) or vol:NAME; asks first (--force
                         doesn't). Delete a home at a path yourself

  workspace              list the volume workspaces, and which are in use
  workspace rm NAME...   delete volume workspaces, named NAME or vol:NAME;
                         asks first (--force doesn't)

  shared new             create ~/.clod/shared as a copy of the starter shared
                         config, to customise; if it exists, list the starter's
                         files it lacks or differs on (--force replaces it,
                         keeping a backup)
  shared diff            show the differences between the starter shared config
                         and ~/.clod/shared

Options (before the command):
  -i, --image NAME       image or variant to run            (CLOD_IMAGE)
                           -i go+sudo    the sudo variant built on go
  -H, --home NAME|PATH   container home                     (CLOD_HOME)
                           -H vol:NAME   the Docker volume clod-home-NAME
  -w, --workspace PATH|vol:NAME
                         the directory to mount as /workspace, instead of the
                         current one
                           -w vol:NAME   the Docker volume clod-workspace-NAME
  -P, --port PORT        publish a port on localhost; repeatable (CLOD_PORTS)
                           -P 5173       localhost:5173 -> container port 5173
                           -P 3000:5173  localhost:3000 -> container port 5173
  -s, --scratch          an empty /workspace, discarded on exit, instead of the
                         current directory; no .envrc is read. Not with -w
  -f, --force            run from a directory clod otherwise refuses; replace
                         an existing clod (install) or shared config (shared
                         new); delete without asking (home rm, workspace rm)
      --skip-build       run the image as built, even if its files have changed
      --docker           mount the host's Docker socket. Only the socket: the
                         docker CLI comes from the image (clod -i docker
                         --docker). WARNING: the socket is root on the Docker
                         host, which can mount and read anything on your machine
  -h, --help             show this help
      --version          show clod's version
  --                     end of options: the rest goes to the default command

With no command, clod runs the default command: claude, unless CLOD_COMMAND
or `clod default command` says otherwise. A command's own args go after it,
unchanged, options included.

Examples:
  clod                     Claude Code
  clod -- --resume         Claude Code with its own arguments
  clod -i go -P 5173       the go variant, with port 5173 published
  clod -H work codex       Codex in the "work" home
  clod -s                  Claude Code in an empty, throwaway /workspace
  clod -w vol:play         Claude Code in the workspace kept in a Docker volume
USAGE
}

# Exits with error message $1 and a pointer to --help.
usage_error() {
  echo "clod: $1 (see clod --help)" >&2
  exit 2
}

# True when $1 is one of the words in list $2.
is_one_of() {
  local word
  for word in $2; do
    [[ $word == "$1" ]] && return 0
  done
  return 1
}

# Prints path $1 with a leading $HOME shown as ~.
tildify() {
  case $1 in
    "$HOME"|"$HOME"/*) printf '%s\n' "~${1#"$HOME"}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Sets REPLY to path $1 made absolute against $PWD, with . and .. resolved but
# symlinks kept; the path need not exist.
abspath() {
  local p=$1 part out=() parts
  [[ $p == /* ]] || p=$PWD/$p
  IFS=/ read -ra parts <<< "$p"
  for part in "${parts[@]}"; do
    case $part in
      ''|.) ;;
      ..) (( ${#out[@]} )) && unset "out[$(( ${#out[@]} - 1 ))]" ;;
      *) out+=("$part") ;;
    esac
  done
  REPLY=
  for part in "${out[@]}"; do REPLY+=/$part; done
  [[ -n $REPLY ]] || REPLY=/
}

# Sets REPLY to directory $1 with symlinks resolved, or to $1 itself if it
# doesn't exist.
realdir() {
  REPLY=$( (cd "$1" 2>/dev/null && pwd -P) || printf '%s\n' "$1")
}

# Sets REPLY to the nearest .envrc from directory $1 up, or to nothing.
find_envrc() {
  local dir=$1
  REPLY=
  while :; do
    [[ -f $dir/.envrc ]] && { REPLY=$dir/.envrc; return; }
    [[ $dir == / ]] && return
    dir=${dir%/*}
    [[ -n $dir ]] || dir=/
  done
}

# Prints the variables envrc file $1 sets, as NAME=value lines. Host-only
# variables (PATH, terminal size, direnv's own) are left out, and multi-line
# ones, which --env-file can't carry, are skipped with a warning.
envrc_vars() {
  local clean=(env -i HOME="$HOME" PATH="$PATH" DIRENV_LOG_FORMAT=) base out err status=0
  local dump='BEGIN {
    for (k in ENVIRON) {
      if (k !~ /^[A-Za-z_][A-Za-z0-9_]*$/) continue
      if (ENVIRON[k] ~ /\n/) print "clod: skipping multi-line variable " k > "/dev/stderr"
      else print k "=" ENVIRON[k]
    }
  }'
  command -v direnv >/dev/null ||
    { echo "clod: ignoring $(tildify "$1"): direnv is not installed" >&2; return 0; }
  [[ -n $XDG_CONFIG_HOME ]] && clean+=(XDG_CONFIG_HOME="$XDG_CONFIG_HOME")
  [[ -n $XDG_DATA_HOME ]] && clean+=(XDG_DATA_HOME="$XDG_DATA_HOME")
  base=$("${clean[@]}" awk "$dump")
  # Some direnv versions log "loading" and "using" lines even with an empty
  # DIRENV_LOG_FORMAT; its other messages still get through.
  err=$(mktemp)
  out=$("${clean[@]}" direnv exec "$(dirname "$1")" awk "$dump" 2>"$err") || status=$?
  grep -vE $'^(\e\\[[0-9;]*m)*direnv: (loading|using) ' "$err" >&2
  rm -f "$err"
  (( status )) && { echo "clod: run 'direnv allow' to use $(tildify "$1")" >&2; return 1; }
  printf '%s\n' "$out" | grep -vxF -f <(printf '%s\n' "$base") |
    grep -vE '^(PATH|PWD|OLDPWD|SHLVL|_|LINES|COLUMNS|DIRENV_[A-Z_]*)=' | sort
  return 0
}

# Sets setting_key, setting_var and setting_builtin to the launcher setting
# whose key or variable is $1, or fails if there is none.
find_setting() {
  local s
  for s in $settings; do
    setting_key=${s%%:*} s=${s#*:}
    setting_var=${s%%:*} setting_builtin=${s#*:}
    [[ $1 == "$setting_key" || $1 == "$setting_var" ]] && return 0
  done
  return 1
}

# Sets the launcher setting that NAME=value line $1 names, unless it is set
# already, even to nothing (CLOD_PORTS= publishes no ports, overriding the envrc
# and config); fails if $1 isn't a launcher setting.
default_setting() {
  [[ $1 == CLOD_*=* ]] || return 1
  find_setting "${1%%=*}" || return 1
  [[ -n ${!setting_var+set} ]] || printf -v "$setting_var" '%s' "${1#*=}"
}

# Resolves a CLOD_HOME-style value ($2, named $1 in errors) into $REPLY: a
# directory, or vol:NAME for a volume home.
resolve_home() {
  if [[ $2 == vol:* ]]; then
    if [[ ! ${2#vol:} =~ $name_re ]]; then
      echo "clod: invalid $1 volume name '${2#vol:}'" >&2
      exit 1
    fi
    REPLY=$2
  elif [[ $2 == */* ]]; then
    abspath "$2"
  elif [[ $2 =~ $name_re ]]; then
    REPLY=$clod_dir/homes/$2
  else
    echo "clod: invalid $1 name '$2' (use ./$2 for a path)" >&2
    exit 1
  fi
}

# Sets REPLY to the directory of variant $1, from ~/.clod/images or else this
# script's images/, or to nothing if there is none.
find_variant() {
  local d
  REPLY=
  [[ $1 =~ $name_re ]] || return 0
  for d in "$clod_dir/images/$1" "$script_dir/images/$1"; do
    if [[ -f $d/Dockerfile ]]; then
      REPLY=$d
      return 0
    fi
  done
}

# Prints the names of the variants, yours and the bundled ones, one per line.
variant_names() {
  local f
  for f in "$clod_dir"/images/*/Dockerfile "$script_dir"/images/*/Dockerfile; do
    [[ -f $f ]] && basename "$(dirname "$f")"
  done | sort -u
}

files_hash() {
  (cd "$1" && find . -type f ! -name '.*' -print0 | sort -z | xargs -0 "$sum") | $sum | cut -d' ' -f1
}

# Prints the hash the clod image is labelled with when built from its files.
base_hash() {
  { cat "$base_dir/Dockerfile" "$base_dir/entrypoint.sh" "$base_dir/container.md"
    printf '%s\n' "${base_args[*]}"; } | $sum | cut -d' ' -f1
}

# Prints the hash a variant from directory $1, FROM images $2..., is labelled
# with when built on those images as they are now.
variant_hash() {
  local dir=$1 parent
  shift
  { for parent in "$@"; do
      docker image inspect -f '{{.Id}}' "$parent" 2>/dev/null
    done
    files_hash "$dir"; } | $sum | cut -d' ' -f1
}

# Prints the images variant directory $1's Dockerfile is FROM, one per line,
# with the ARGs declared before its first FROM expanded; BASE is $2 if given.
variant_parents() {
  awk -v base="$2" '
    function expand(s,   out, name) {
      out = ""
      while (match(s, /\$\{[A-Za-z_][A-Za-z0-9_]*\}|\$[A-Za-z_][A-Za-z0-9_]*/)) {
        name = substr(s, RSTART, RLENGTH)
        gsub(/[${}]/, "", name)
        out = out substr(s, 1, RSTART - 1) arg[name]
        s = substr(s, RSTART + RLENGTH)
      }
      return out s
    }
    toupper($1) == "ARG" && !from {
      name = $2; value = ""
      if (i = index(name, "=")) { value = substr(name, i + 1); name = substr(name, 1, i - 1) }
      gsub(/^"|"$/, "", value)
      arg[name] = (name == "BASE" && base != "") ? base : value
    }
    toupper($1) == "FROM" {
      from = 1
      for (i = 2; i <= NF; i++) if ($i !~ /^--/) { print expand($i); break }
    }' "$1/Dockerfile"
}

# True when variant directory $1's Dockerfile declares ARG BASE before its first
# FROM, so it can be built on another variant.
takes_base() {
  awk 'toupper($1) == "FROM" { exit } toupper($1) == "ARG" && $2 ~ /^BASE(=|$)/ { found = 1 }
    END { exit !found }' "$1/Dockerfile"
}

# Sets REPLY to the directory of the variant clod image $1 is built from, or to
# nothing if it isn't a variant's, and variant_base to the image a combination's
# last variant is built on (clod-a.b for clod-a.b.c), or to nothing. Of the
# variants its name lists, variant_missing is the first that doesn't exist, and
# variant_fixed the first after the first that doesn't take ARG BASE.
tag_variant() {
  local parts part i=0
  REPLY='' variant_base='' variant_missing='' variant_fixed=''
  IFS=. read -ra parts <<< "${1#clod-}"
  for part in ${parts[@]+"${parts[@]}"}; do
    find_variant "$part"
    [[ -n $REPLY ]] || { variant_missing=$part; return 0; }
    (( i++ )) && [[ -z $variant_fixed ]] && ! takes_base "$REPLY" && variant_fixed=$part
  done
  [[ $1 == clod-?* && $1 != clod-.* && $1 != *. && $1 != *..* ]] || { REPLY=''; return 0; }
  (( ${#parts[@]} > 1 )) && variant_base=${1%.*}
  return 0
}

# Sets REPLY to the tag of the variant or combination image name $1 means:
# clod-NAME for NAME or clod-NAME, clod-A.B for A+B, A.B or clod-A.B. Sets it
# to nothing when $1 is neither, so names a local docker image. Exits with an
# error when $1 is a combination clod can't build: a name with + in it whose
# parts aren't all variants, or one whose variants after the first don't take
# ARG BASE.
resolve_variant() {
  local name=${1//+/.}
  if [[ $1 == *+* ]]; then
    case ${name#clod-} in
      .*|*.|*..*)
        echo "clod: invalid image name '$1': a combination is variants joined by +, like go+sudo" >&2
        exit 1
        ;;
    esac
  fi
  tag_variant "clod-${name#clod-}"
  if [[ -n $variant_fixed ]]; then
    echo "clod: variant $variant_fixed can't go on top of another: its Dockerfile needs ARG BASE=clod and FROM \$BASE in place of FROM clod" >&2
    exit 1
  fi
  if [[ -n $variant_missing && $1 == *+* ]]; then
    echo "clod: no variant named '$variant_missing' (clod image lists them)" >&2
    exit 1
  fi
  if [[ -n $REPLY ]]; then
    REPLY=clod-${name#clod-}
  elif [[ $name == clod-* ]]; then
    # a variant named clod-NAME
    tag_variant "clod-$name"
    [[ -n $REPLY ]] && REPLY=clod-$name
  fi
  return 0
}

# Builds $1 from directory $2, with any further docker build arguments, unless
# the image is already labelled with hash $3. For `clod image rebuild` it always
# builds, without the layer cache.
built=''
build_if_changed() {
  local no_cache=()
  if [[ $verb == rebuild ]]; then
    no_cache=(--no-cache)
  else
    [[ $(docker image inspect -f '{{index .Config.Labels "clod.hash"}}' "$1" 2>/dev/null) == "$3" ]] && return
  fi
  echo "clod: building $1..." >&2
  docker build -t "$1" --label "clod.hash=$3" ${no_cache[@]+"${no_cache[@]}"} "${@:4}" "$2" || exit 1
  built=1
}

# Goes through clod image $1 and the clod images it is FROM, in every stage, so
# a multi-stage Dockerfile can name one in any stage. With $2 build, it builds
# those of them clod has files for, bases first, wherever they changed. With $2
# state, it sets REPLY to the state of $1: - when it isn't built, stale when its
# next run rebuilds it (its files or an image it is FROM changed), or else
# built. An image clod has no files for is built or -.
walking=() walked=()
walk_image() {
  local tag=$1 mode=$2 label dir base hash parent parents=() build_args=() stale='' t
  if [[ $mode == state ]]; then
    REPLY=-
    label=$(docker image inspect -f '{{index .Config.Labels "clod.hash"}}' "$tag" 2>/dev/null) || return 0
    REPLY=built
  fi
  for t in ${walking[@]+"${walking[@]}"}; do
    [[ $t == "$tag" ]] || continue
    [[ $mode == state ]] && return 0
    echo "clod: image $tag is built FROM itself" >&2
    exit 1
  done
  if [[ $mode == build ]]; then
    for t in ${walked[@]+"${walked[@]}"}; do
      [[ $t == "$tag" ]] && return 0
    done
    walked+=("$tag")
  fi
  if [[ $tag == clod ]]; then
    [[ -n $base_dir ]] || return 0
    dir=$base_dir hash=$(base_hash)
    build_args=(${base_args[@]+"${base_args[@]}"})
    [[ $verb == rebuild ]] && build_args+=(--pull)
  else
    tag_variant "$tag"
    dir=$REPLY base=$variant_base
    REPLY=built
    [[ -n $dir ]] || return 0
    [[ -n $base ]] && build_args=(--build-arg "BASE=$base")
    while IFS= read -r parent; do
      parents+=("$parent")
    done < <(variant_parents "$dir" "$base")
    walking+=("$tag")
    for parent in ${parents[@]+"${parents[@]}"}; do
      [[ $parent == clod || $parent == clod-* ]] || continue
      walk_image "$parent" "$mode"
      [[ $REPLY == built ]] || stale=1
    done
    unset 'walking[${#walking[@]}-1]'
    hash=$(variant_hash "$dir" ${parents[@]+"${parents[@]}"})
  fi
  if [[ $mode == build ]]; then
    build_if_changed "$tag" "$dir" "$hash" ${build_args[@]+"${build_args[@]}"}
  else
    REPLY=built
    [[ -n $stale || $label != "$hash" ]] && REPLY=stale
  fi
  return 0
}

# Exits with advice when Docker is missing or its daemon isn't running.
need_docker() {
  if ! command -v docker >/dev/null; then
    echo "clod: docker isn't installed (see docs/docker.md in clod's checkout)" >&2
    exit 1
  fi
  if ! docker version -f '{{.Server.Version}}' >/dev/null 2>&1; then
    echo "clod: can't reach Docker; start it (colima start, or open Docker Desktop) and try again" >&2
    exit 1
  fi
}

# True when directory $1 is /, your home directory or one above it, ~/.clod or
# ~/.clod/homes, which clod won't mount without --force, since the agent would
# see your credentials and every home's login, nor copy, move or delete as a
# home.
off_limits() {
  realdir "$1"
  [[ $REPLY == / || $host_home == "$REPLY" || $host_home == "$REPLY"/* ||
     $REPLY == "$clod_real" || $REPLY == "$clod_real/homes" ]]
}

# The setup phases.

# Reads the command line into scratch, workspace_opt, force, skip_build,
# docker_socket, command (empty for the default command), verb (a noun's, or
# empty) and args, the command's arguments.
# Options set the launcher settings, winning over the environment, the envrc and
# ~/.clod/config, even with an empty value (-P '' publishes no ports).
parse_args() {
  local opt_ports=() dashdash='' arg
  scratch='' workspace_opt='' force='' skip_build='' docker_socket='' command='' verb=''
  while (( $# )); do
    case $1 in
      -i|--image|-H|--home|-w|--workspace|-P|--port)
        [[ $# -ge 2 ]] || usage_error "$1 needs a value"
        case $1 in
          -i|--image) CLOD_IMAGE=$2 ;;
          -H|--home) CLOD_HOME=$2 ;;
          -w|--workspace) workspace_opt=$2 ;;
          -P|--port) opt_ports+=("$2") ;;
        esac
        shift 2
        ;;
      --image=*) CLOD_IMAGE=${1#*=}; shift ;;
      --home=*) CLOD_HOME=${1#*=}; shift ;;
      --workspace=*) workspace_opt=${1#*=}; shift ;;
      --port=*) opt_ports+=("${1#*=}"); shift ;;
      -s|--scratch) scratch=1; shift ;;
      -f|--force) force=1; shift ;;
      --skip-build) skip_build=1; shift ;;
      --docker) docker_socket=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --version) echo "clod $(clod_version)"; exit 0 ;;
      --) shift; dashdash=1; break ;;
      # Claude Code's -p (print) and -c (continue), typed as if clod were claude.
      -p|-c) usage_error "unknown option $1; for Claude Code's $1, use: clod claude $1 ..." ;;
      -*) usage_error "unknown option $1; a command's own options go after it, or after --" ;;
      *) break ;;
    esac
  done
  if [[ -z $dashdash && $# -gt 0 ]]; then
    is_one_of "$1" "$commands $alias_commands" ||
      usage_error "unknown command '$1'; the default command's args go after --"
    command=$1
    shift
  fi
  if is_one_of "$command" "$alias_commands"; then
    echo "clod: clod $command is deprecated; use clod image $command" >&2
    verb=$command command=image
  elif is_one_of "$command" "$nouns" && (( $# )); then
    noun_verbs "$command"
    is_one_of "$1" "$REPLY" || usage_error "unknown $command command '$1' (one of: ${REPLY// /, })"
    verb=$1
    shift
  fi
  case $command${verb:+ $verb} in
    env|image|'image prune'|home|workspace|'shared new'|'shared diff'|update|completion)
      (( $# == 0 )) || usage_error "$command${verb:+ $verb} takes no arguments" ;;
    install) (( $# <= 1 )) || usage_error "install takes at most one directory" ;;
    shared) usage_error "shared takes a command: new or diff" ;;
    'image show') (( $# == 1 )) || usage_error "image show takes one image name" ;;
    'image new') (( $# == 1 || $# == 2 )) || usage_error "image new takes a NAME and at most one image to start from" ;;
    'home cp'|'home mv') (( $# == 2 )) || usage_error "home $verb takes a SRC and a DEST home" ;;
    'home rm') (( $# )) || usage_error "home rm takes one or more NAME or vol:NAME" ;;
    'workspace rm') (( $# )) || usage_error "workspace rm takes one or more NAME or vol:NAME" ;;
  esac
  case $command${verb:+ $verb} in
    'home '*|'workspace rm')
      for arg; do
        [[ $arg == -* ]] && usage_error "clod's options go before the command"
        [[ $command$verb == homerm && $arg == */* ]] &&
          usage_error "home rm takes home names and vol:NAME; delete the home $arg yourself"
      done
      ;;
  esac
  [[ -n $scratch && -n $workspace_opt ]] && usage_error "--scratch and --workspace don't combine"
  args=("$@")
  (( ${#opt_ports[@]} )) && CLOD_PORTS="${opt_ports[*]}"
  return 0
}

# Sets workspace to the directory mounted as /workspace, vol:NAME for a volume
# workspace or nothing for a scratch one, workspace_label to its label and
# workspace_src to what is mounted: the directory, or the Docker volume
# clod-workspace-NAME.
setup_workspace() {
  local w=${workspace_opt:-.}
  workspace='' workspace_label='' workspace_src=''
  [[ -n $scratch ]] && return 0
  if [[ $w == vol:* ]]; then
    if [[ ! ${w#vol:} =~ $name_re ]]; then
      echo "clod: invalid workspace volume name '${w#vol:}'" >&2
      exit 1
    fi
    workspace=$w workspace_label=$w workspace_src=clod-workspace-${w#vol:}
    return 0
  fi
  abspath "$w"
  workspace=$REPLY workspace_label=$(tildify "$REPLY") workspace_src=$REPLY
}

# Exits unless the workspace directory exists, which Docker would refuse to
# mount with a less helpful message.
check_workspace() {
  [[ -z $workspace || $workspace == vol:* || -d $workspace ]] && return 0
  echo "clod: no directory $workspace_label to mount as /workspace" >&2
  exit 1
}

# Sets envrc to the envrc in use (none with --scratch or a volume workspace)
# and vars to the variables it sets, except the launcher settings: those, and
# then ~/.clod/config's, are defaults for the shell's.
load_settings() {
  local out line
  envrc=''
  if [[ -n $workspace && $workspace != vol:* ]]; then
    find_envrc "$workspace"
    envrc=$REPLY
  fi
  vars=()
  if [[ -n $envrc ]]; then
    out=$(envrc_vars "$envrc") || exit 1
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      # Launcher settings from the envrc are defaults for the shell's, not
      # container variables.
      default_setting "$line" || vars+=("$line")
    done <<< "$out"
  fi
  # ~/.clod/config holds launcher settings as NAME=value lines, defaults for both
  # the shell's and the envrc's.
  if [[ -f $config ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      default_setting "$line"
    done < "$config"
  fi
}

# With no command, the default command runs.
default_command() {
  command=${CLOD_COMMAND:-claude}
  is_one_of "$command" "$run_commands" && return 0
  local others=${run_commands% *}
  echo "clod: CLOD_COMMAND is '$command'; it must be ${others// /, } or ${run_commands##* }" >&2
  exit 1
}

# Sets home and home_label to the container home, and home_src to what is
# mounted as /home/claude: its directory, or the Docker volume clod-home-NAME
# for vol:NAME.
setup_home() {
  resolve_home CLOD_HOME "${CLOD_HOME:-default}"
  home=$REPLY
  home_label=$(tildify "${home#"$clod_dir/homes/"}")
  home_src=$home
  [[ $home == vol:* ]] && home_src=clod-home-${home#vol:}
}

# Sets tag to the image to run, image to its name, and variant_dir to the
# directory of the variant it is built from (the last, for a combination), or
# to nothing. A variant NAME is built as clod-NAME, and a combination A+B, B
# built on A, as clod-A.B; image becomes NAME or A.B.
setup_image() {
  image=${CLOD_IMAGE:-clod}
  if [[ $image == *[[:space:]]* ]]; then
    echo "clod: invalid CLOD_IMAGE '$image'" >&2
    exit 1
  fi
  resolve_variant "$image"
  if [[ -n $REPLY ]]; then
    tag=$REPLY
    image=${tag#clod-}
    tag_variant "$tag"
    variant_dir=$REPLY
  else
    tag=$image variant_dir=''
  fi
}

# Sets shared_dir to the shared config to mount, port_args and container_ports
# to CLOD_PORTS's, and tz to the timezone.
setup_container() {
  local p
  shared_dir=$clod_dir/shared
  [[ -d $shared_dir ]] || shared_dir=$script_dir/shared
  [[ -d $shared_dir ]] || shared_dir=

  # Publishes each CLOD_PORTS entry on the host's 127.0.0.1 unless it names an
  # address, and collects the container ports for the container's CLOD_PORTS.
  port_args=() container_ports=()
  for p in ${CLOD_PORTS//,/ }; do
    if [[ ! $p =~ $port_re ]]; then
      echo "clod: invalid port '$p' (use PORT, HOST:CONTAINER or ADDRESS:HOST:CONTAINER)" >&2
      exit 1
    fi
    case $p in
      *.*:*|\[*) port_args+=(-p "$p") ;;
      *:*) port_args+=(-p "127.0.0.1:$p") ;;
      *) port_args+=(-p "127.0.0.1:$p:$p") ;;
    esac
    container_ports+=("${p##*:}")
  done

  tz=${TZ:-$(readlink /etc/localtime 2>/dev/null)}
  tz=${tz##*zoneinfo/}
}

# Exits, unless --force, when the workspace or the home is off limits.
refuse_off_limits() {
  local real
  realdir "$HOME"; host_home=$REPLY
  realdir "$clod_dir"; clod_real=$REPLY
  [[ -n $force ]] && return 0
  if [[ -n $workspace && $workspace != vol:* ]]; then
    realdir "$workspace"; real=$REPLY
  else
    real=''
  fi
  if [[ -n $real ]] && { off_limits "$real" || [[ $real == "$clod_real/homes"/* ]]; }; then
    echo "clod: refusing to mount $workspace_label as /workspace: it holds your credentials or a home's login (clod --force to run anyway)" >&2
    exit 1
  fi
  if [[ $home != vol:* ]] && off_limits "$home"; then
    echo "clod: refusing to use $(tildify "$home") as the container's home: it holds your credentials or every home's login (clod --force to run anyway)" >&2
    exit 1
  fi
}

# The commands.

# Links clod into directory $1, or the first of these on PATH that you can
# write to, else ~/.local/bin.
cmd_install() {
  local target=$script_dir/clod dir=$1 d link rc
  if [[ -z $dir ]]; then
    for d in "$HOME/.local/bin" "$HOME/bin" /opt/homebrew/bin /usr/local/bin; do
      case ":$PATH:" in
        *":$d:"*) if [[ -d $d && -w $d ]]; then dir=$d; break; fi ;;
      esac
    done
    [[ -n $dir ]] || dir=$HOME/.local/bin
  fi
  link=$dir/clod
  if [[ -L $link && $(readlink "$link") == "$target" ]]; then
    echo "clod is already installed as $(tildify "$link")"
  elif [[ -e $link || -L $link ]] && [[ -z $force ]]; then
    echo "clod: $(tildify "$link") already exists; clod --force install replaces it" >&2
    exit 1
  else
    mkdir -p "$dir" && ln -sfn "$target" "$link" || exit 1
    echo "clod: installed $(tildify "$link") -> $(tildify "$target")"
  fi
  case ${SHELL##*/} in
    zsh) rc=$(tildify "$HOME/.zshrc") ;;
    bash) if [[ $OSTYPE == darwin* ]]; then rc=$(tildify "$HOME/.bash_profile"); else rc=$(tildify "$HOME/.bashrc"); fi ;;
    *) rc='your shell startup file' ;;
  esac
  case ":$PATH:" in
    *":$dir:"*) ;;
    *)
      echo
      echo "$(tildify "$dir") isn't on your PATH. Add this line to $rc, then open a new terminal:"
      echo "  export PATH=\"${dir/#$HOME/\$HOME}:\$PATH\""
      ;;
  esac
  echo
  echo "For tab completion, add this line to $rc:"
  # shellcheck disable=SC2016 # printed for the shell startup file, unexpanded
  echo '  eval "$(clod completion)"'
}

# Prints the tab completion shim, for bash and zsh. It hands the words to
# clod __complete, and completes file names only when that exits 1.
cmd_completion() {
  cat <<'SHIM'
# clod's tab completion, for bash and zsh: eval "$(clod completion)"
if [ -n "${ZSH_VERSION-}" ]; then
  (( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
  _clod() {
    local -a reply
    # A file name after = (--workspace=DIR) is completed from the =.
    reply=(${(f)"$(clod __complete "${(@)words[2,CURRENT]}")"}) ||
      { [[ $PREFIX == -*=* ]] && compset -P '*='; _files; return; }
    compadd -a reply
  }
  compdef _clod clod
else
  _clod() {
    local IFS=$'\n'
    COMPREPLY=($(clod __complete "${COMP_WORDS[@]:1:$COMP_CWORD}")) || compopt -o default 2>/dev/null
  }
  # bash 3.2 has no compopt, so there it falls back to file names whenever
  # nothing else matches.
  if type compopt >/dev/null 2>&1; then
    complete -F _clod clod
  else
    complete -o default -F _clod clod
  fi
fi
SHIM
}

# Prints the words in $@ that start with the word being completed, $cur, as
# the shell completes them: after $pre (an option's --NAME=), less $strip (what
# bash, which splits words at = and :, has before its own current word). Skips
# the words in $given, the names a command has already.
offer() {
  local word out
  for word in "$@"; do
    [[ $word == "$cur"* ]] || continue
    is_one_of "$word" "$given" && continue
    out=$pre$word
    printf '%s\n' "${out#"$strip"}"
  done
  return 0
}

# Prints the names of the Docker volumes named $1NAME, as NAME, if Docker is
# up; the name filter matches anywhere in a name.
volume_names() {
  local v
  while IFS= read -r v; do
    [[ $v == "$1"* ]] && printf '%s\n' "${v#"$1"}"
  done < <(docker volume ls -q --filter "name=$1" 2>/dev/null)
  return 0
}

# Offers image names: clod (unless $1 is "variants") and the variants, or after
# a + the variants that can go on top and aren't in the combination yet. Reads
# $cur and $variants from cmd_complete.
offer_images() {
  local v below on_top=()
  if [[ $cur == *+* ]]; then
    below=${cur%+*}
    for v in $variants; do
      [[ +$below+ == *+$v+* ]] && continue
      find_variant "$v"
      takes_base "$REPLY" && on_top+=("$below+$v")
    done
    offer ${on_top[@]+"${on_top[@]}"}
  else
    [[ $1 == variants ]] || offer clod
    # shellcheck disable=SC2086 # variant names don't contain spaces or globs
    offer $variants
  fi
}

# `clod __complete WORDS...`, which the shim calls: prints the candidates for
# the last word, given the words before it, one per line, or exits 1 where the
# word is a file name: a command's arguments, a home's path or install's
# directory. It reads only directories, never the envrc, and asks Docker only
# for volume homes and workspaces and image rm's images, so it's quick.
cmd_complete() {
  local raw=("$@") words=() cur last pre='' strip='' glue='' cmd='' cmd_args=() prev=''
  local word i s keys='' homes='' variants verb='' given=''
  # bash splits a word at = and : (--home=vol:NAME, -P 3000:5173) into pieces,
  # with each = and : a piece of its own; this joins them back up.
  for word in ${raw[@]+"${raw[@]}"}; do
    if [[ -n $glue || $word == [=:] ]] && (( ${#words[@]} )); then
      words[${#words[@]}-1]+=$word
    else
      words+=("$word")
    fi
    if [[ $word == [=:] ]]; then glue=1; else glue=''; fi
  done
  (( ${#words[@]} )) || words=('')
  cur=${words[${#words[@]}-1]}
  unset 'words[${#words[@]}-1]'
  last=${raw[${#raw[@]}-1]}
  [[ $last == [=:] ]] && last=''
  strip=${cur%"$last"}
  for (( i = 0; i < ${#words[@]}; i++ )); do
    word=${words[i]}
    if [[ -n $cmd ]]; then
      cmd_args+=("$word")
      continue
    fi
    case $word in
      --) return 1 ;;
      -i|--image|-H|--home|-w|--workspace|-P|--port) (( i++ )) ;;
      -*) ;;
      *) cmd=$word ;;
    esac
  done
  (( ${#words[@]} )) && prev=${words[${#words[@]}-1]}
  # An option's value in the same word: --home=NAME.
  if [[ -z $cmd && $cur == --*=* ]]; then
    prev=${cur%%=*} pre=${cur%%=*}= cur=${cur#*=}
  fi
  variants=$(variant_names)
  # A home is a name, vol:NAME or, with a slash, a path, which the shell
  # completes.
  if [[ $cur != */* ]]; then
    for word in "$clod_dir"/homes/*/; do
      [[ -d $word ]] && word=${word%/} && homes+=" ${word##*/}"
    done
    if [[ $prev == -H || $prev == --home || $cmd == default && ${cmd_args[0]} == home ]]; then
      while IFS= read -r word; do homes+=" vol:$word"; done < <(volume_names clod-home-)
    fi
  fi
  for s in $settings; do keys+=" ${s%%:*}"; done
  # shellcheck disable=SC2086 # the lists are words without spaces or globs
  if [[ -z $cmd ]]; then
    case $prev in
      -i|--image) offer_images ;;
      -H|--home) [[ $cur == */* ]] && return 1; offer $homes ;;
      # A workspace is a path, which the shell completes, or vol:NAME.
      -w|--workspace)
        [[ $cur == vol:* ]] || return 1
        # shellcheck disable=SC2046 # volume names are words
        offer $(volume_names clod-workspace- | sed 's/^/vol:/')
        ;;
      -P|--port) ;;
      *) if [[ $cur == -* ]]; then offer $options; else offer $commands; fi ;;
    esac
  elif [[ " $run_commands " == *" $cmd "* ]]; then
    return 1
  elif [[ $cmd == install && ${#cmd_args[@]} == 0 ]]; then
    return 1
  elif [[ $cmd == default ]]; then
    case ${#cmd_args[@]}:${cmd_args[0]} in
      0:*) offer $keys ;;
      1:image) offer_images; offer --reset ;;
      1:command) offer $run_commands --reset ;;
      1:home) [[ $cur == */* ]] && return 1; offer $homes --reset ;;
      1:ports) offer --reset ;;
    esac
  elif is_one_of "$cmd" "$nouns"; then
    if (( ${#cmd_args[@]} == 0 )); then
      noun_verbs "$cmd"
      offer $REPLY
      return 0
    fi
    verb=${cmd_args[0]}
    unset 'cmd_args[0]'
    cmd_args=(${cmd_args[@]+"${cmd_args[@]}"})
    # The names given already, with and without vol:.
    for word in ${cmd_args[@]+"${cmd_args[@]}"}; do
      given+=" $word vol:${word#vol:} ${word#vol:}"
    done
    # shellcheck disable=SC2046 # image and volume names are words
    case $cmd:$verb in
      image:show) (( ${#cmd_args[@]} )) || offer_images ;;
      image:build|image:rebuild) offer_images ;;
      # The images clod built, named as clod image lists them.
      image:rm)
        offer $(docker image ls --filter label=clod.hash --format '{{.Repository}}' 2>/dev/null |
          sed -n 's/^clod-//p; /^clod$/p' | sort -u)
        ;;
      image:new) (( ${#cmd_args[@]} == 1 )) && offer_images variants ;;
      home:rm) offer $homes $(volume_names clod-home- | sed 's/^/vol:/') ;;
      # The source is a home, and the destination a new one, so nothing
      # completes there but a path.
      home:cp|home:mv)
        [[ $cur == */* ]] && return 1
        if (( ${#cmd_args[@]} == 0 )); then
          offer $homes $(volume_names clod-home- | sed 's/^/vol:/')
        fi
        ;;
      # A workspace is named NAME, or vol:NAME once its v is typed.
      workspace:rm)
        offer $(volume_names clod-workspace-)
        if [[ -n $cur && ( $cur == vol:* || vol: == "$cur"* ) ]]; then
          offer $(volume_names clod-workspace- | sed 's/^/vol:/')
        fi
        ;;
    esac
  fi
  return 0
}

cmd_update() {
  local before after count
  if ! git -C "$script_dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "clod: $(tildify "$script_dir") isn't a git checkout, so there's nothing to update" >&2
    exit 1
  fi
  before=$(git -C "$script_dir" rev-parse HEAD)
  if ! git -C "$script_dir" pull --ff-only --quiet; then
    echo "clod: git pull failed in $(tildify "$script_dir") (git's message is above); sort it out with git there" >&2
    exit 1
  fi
  after=$(git -C "$script_dir" rev-parse HEAD)
  if [[ $before == "$after" ]]; then
    echo "clod $(clod_version) is up to date"
    return 0
  fi
  # One line per change: --first-parent shows a merged pull request as its
  # merge commit rather than every commit inside it.
  count=$(git -C "$script_dir" rev-list --first-parent --count "$before..$after")
  echo "clod updated to $(clod_version), $count change$([[ $count == 1 ]] || echo s):"
  git -C "$script_dir" log --first-parent --no-decorate --format='  %h %s' -n 20 "$before..$after"
  if (( count > 20 )); then
    echo "  ... and $((count - 20)) more: git -C $(tildify "$script_dir") log"
  fi
}

# Prints setting $1 with its value in the config file, or its built-in value.
show_setting() {
  local value
  find_setting "$1"
  value=$(sed -n "s/^$setting_var=//p" "$config" 2>/dev/null | tail -1)
  if [[ -n $value ]]; then
    printf '%-8s %-14s (%s)\n' "$1" "$value" "$(tildify "$config")"
  else
    printf '%-8s %-14s (built in)\n' "$1" "$setting_builtin"
  fi
}

# Shows the launcher settings in ~/.clod/config, or setting $1, or sets it to
# $2.
cmd_default() {
  local keys='' s key=$1 value=$2 var rest p
  for s in $settings; do keys+="${keys:+ }${s%%:*}"; done
  if [[ $# -eq 0 ]]; then
    for s in $keys; do show_setting "$s"; done
    echo
    echo "clod default KEY VALUE sets one; clod default KEY --reset removes it"
    return 0
  fi
  is_one_of "$key" "$keys" || usage_error "unknown setting '$key' (one of: ${keys// /, })"
  if [[ $# -eq 1 ]]; then
    show_setting "$key"
    return 0
  fi
  [[ $# -eq 2 ]] || usage_error "default takes a setting and one value"
  find_setting "$key"
  var=$setting_var
  [[ $value == --reset || $value == "$setting_builtin" ]] && value=''
  if [[ -n $value ]]; then
    case $key in
      image)
        resolve_variant "$value"
        if [[ -z $REPLY ]] && ! docker image inspect "$value" >/dev/null 2>&1; then
          echo "clod: no variant or local image named '$value' (clod image lists them)" >&2
          exit 1
        fi
        ;;
      command)
        is_one_of "$value" "$run_commands" ||
          usage_error "the default command is one of ${run_commands// /, }"
        ;;
      home)
        # A path is stored absolute, since the config applies everywhere.
        resolve_home "$var" "$value"
        [[ $value == */* ]] && value=$REPLY
        ;;
      ports)
        for p in ${value//,/ }; do
          [[ $p =~ $port_re ]] || usage_error "invalid port '$p'"
        done
        ;;
    esac
  fi
  mkdir -p "$clod_dir"
  rest=$(grep -v "^$var=" "$config" 2>/dev/null)
  {
    if [[ -n $rest ]]; then printf '%s\n' "$rest"; fi
    if [[ -n $value ]]; then echo "$var=$value"; fi
  } > "$config.tmp" && mv "$config.tmp" "$config"
  show_setting "$key"
}

# True when a container, running or stopped, uses image $1, which Docker then
# won't remove. Asks Docker for the containers' images once.
used_ids='' used_loaded=''
in_use() {
  local id ids
  if [[ -z $used_loaded ]]; then
    ids=$(docker ps -aq 2>/dev/null)
    # shellcheck disable=SC2086 # container ids are words
    [[ -n $ids ]] && used_ids=$(docker inspect -f '{{.Image}}' $ids 2>/dev/null)
    used_loaded=1
  fi
  id=$(docker image inspect -f '{{.Id}}' "$1" 2>/dev/null) || return 1
  [[ $'\n'$used_ids$'\n' == *$'\n'$id$'\n'* ]]
}

# Sets REPLY to the state of image $1 as clod image shows it: walk_image's,
# with ", in use" when a container uses it.
image_state() {
  walk_image "$1" state
  [[ $REPLY == stale ]] && any_stale=1
  if [[ $REPLY != - ]] && in_use "$1"; then
    REPLY+=', in use'
    any_used=1
  fi
}

# Adds a row for clod image $1 to the chain_* arrays, then the rows of the clod
# images it is FROM, in any stage, each once.
chain_seen=() chain_rows=()
image_chain() {
  local tag=$1 dir base='' src from='' parent parents=() t
  for t in ${chain_seen[@]+"${chain_seen[@]}"}; do
    [[ $t == "$tag" ]] && return 0
  done
  chain_seen+=("$tag")
  if [[ $tag == clod ]]; then
    dir=$base_dir
    src=$([[ -n $dir ]] && tildify "$dir/Dockerfile" || echo 'local image')
    src+=' (base)'
  else
    tag_variant "$tag"
    dir=$REPLY base=$variant_base
    src=$([[ -n $dir ]] && tildify "$dir/Dockerfile" || echo 'local image')
  fi
  if [[ -n $dir ]]; then
    while IFS= read -r parent; do
      parents+=("$parent")
      from+="${from:+, }$parent"
    done < <(variant_parents "$dir" "$base")
  fi
  image_state "$tag"
  chain_rows+=("${tag#clod-}" "$REPLY" "${from:--}" "$src")
  for parent in ${parents[@]+"${parents[@]}"}; do
    [[ $parent == clod || $parent == clod-* ]] && image_chain "$parent"
  done
  return 0
}

# Shows how image $1 is built: the chain of clod images it is FROM, with their
# Dockerfiles.
cmd_image_show() {
  local tag i w=(4 5 4)
  if [[ $1 == clod ]]; then
    tag=clod
  else
    resolve_variant "$1"
    tag=$REPLY
    if [[ -z $tag ]]; then
      echo "clod: no variant named '$1' (clod image lists them)" >&2
      exit 1
    fi
  fi
  image_chain "$tag"
  for (( i = 0; i < ${#chain_rows[@]}; i += 4 )); do
    (( ${#chain_rows[i]} > w[0] )) && w[0]=${#chain_rows[i]}
    (( ${#chain_rows[i+1]} > w[1] )) && w[1]=${#chain_rows[i+1]}
    (( ${#chain_rows[i+2]} > w[2] )) && w[2]=${#chain_rows[i+2]}
  done
  printf "%-${w[0]}s  %-${w[1]}s  %-${w[2]}s  %s\n" NAME STATE FROM SOURCE
  for (( i = 0; i < ${#chain_rows[@]}; i += 4 )); do
    printf "%-${w[0]}s  %-${w[1]}s  %-${w[2]}s  %s\n" "${chain_rows[@]:i:4}"
  done
}

# Lists the base image, the variants and the images clod built, with their
# states.
cmd_image() {
  local n src t i names tags srcs states=() state_width=5 mark
  any_stale='' any_used=''
  names=(clod) tags=(clod)
  srcs=("$([[ -n $base_dir ]] && echo bundled || echo 'local image') (base)")
  for n in $(variant_names); do
    if [[ -f $clod_dir/images/$n/Dockerfile ]]; then
      src=$(tildify "$clod_dir/images/$n")
      [[ -f $script_dir/images/$n/Dockerfile ]] && src="$src (overrides bundled)"
    else
      src=bundled
    fi
    names+=("$n") tags+=("clod-$n") srcs+=("$src")
  done
  # Combinations that are built, the one that runs here, and images clod built
  # whose variant has gone.
  for t in $({ docker image ls --filter label=clod.hash --format '{{.Repository}}' 2>/dev/null
              [[ $tag == clod-*.* ]] && echo "$tag"; } | grep '^clod-' | sort -u); do
    is_one_of "$t" "${tags[*]}" && continue
    n=${t#clod-}
    tag_variant "$t"
    src=${n//./ + }
    [[ -n $variant_missing ]] && src="$src (no Dockerfile)"
    names+=("$n") tags+=("$t") srcs+=("$src")
  done
  name_width=4
  for (( i = 0; i < ${#names[@]}; i++ )); do
    (( ${#names[i]} > name_width )) && name_width=${#names[i]}
    image_state "${tags[i]}"
    states+=("$REPLY")
    (( ${#REPLY} > state_width )) && state_width=${#REPLY}
  done
  printf "  %-${name_width}s  %-${state_width}s  %s\n" NAME STATE SOURCE
  for (( i = 0; i < ${#names[@]}; i++ )); do
    mark=' '
    [[ ${names[i]} == "$image" ]] && mark='*'
    printf "%s %-${name_width}s  %-${state_width}s  %s\n" "$mark" "${names[i]}" "${states[i]}" "${srcs[i]}"
  done
  echo
  echo "*        runs here by default; clod -i NAME runs another, and clod -i A+B"
  echo "         builds variant B on A as clod-A.B"
  echo "bundled  comes with clod, in $(tildify "$script_dir")"
  [[ -n $any_stale ]] && echo "stale    changed since it was built; its next run rebuilds it"
  [[ -n $any_used ]] && echo "in use   a container, maybe a stopped one, uses it (docker ps -a), so it can't be removed"
  echo "clod image rm NAME removes a built image, and clod image prune the stale ones"
  return 0
}

# Removes image $1. An image others are built on loses only its name, keeping
# the layers they use; they rebuild on their next run, as their base changed.
remove_tag() {
  local out
  if ! out=$(docker rmi "$1" 2>&1); then
    echo "clod: can't remove $1: $out" >&2
    exit 1
  fi
  if [[ $out == *Deleted:* ]]; then
    echo "removed $1"
  else
    echo "removed the name $1; its layers stay while images built on it use them"
  fi
}

# Removes the images clod built named $@ (as for -i), or with none named the
# image -i selects, or none if any isn't one.
cmd_image_rm() {
  local name n tags=() t
  (( $# )) || set -- "$image"
  for name; do
    n=${name//+/.}
    t=clod-${n#clod-}
    [[ $name == clod ]] && t=clod
    if [[ -z $(docker image inspect -f '{{index .Config.Labels "clod.hash"}}' "$t" 2>/dev/null) ]]; then
      echo "clod: no image clod built named '$name' (clod image lists them)" >&2
      exit 1
    fi
    if in_use "$t"; then
      echo "clod: a container uses $t, so it can't be removed; docker ps -a lists the containers" >&2
      exit 1
    fi
    tags+=("$t")
  done
  for t in "${tags[@]}"; do
    remove_tag "$t"
  done
}

# Removes the images clod built that are stale, except those a container uses,
# and the untagged ones builds replaced. Images built on others go first, so a
# base's layers are freed with the last image using them; the base image goes
# last.
cmd_image_prune() {
  local t stale=() used=()
  while IFS= read -r t; do
    walk_image "$t" state
    [[ $REPLY == stale ]] || continue
    if in_use "$t"; then used+=("$t"); else stale+=("$t"); fi
  done < <(docker image ls --filter label=clod.hash --format '{{.Repository}}' |
    grep -E '^clod(-|$)' | sort -u |
    awk '{ n = $0 == "clod" ? -1 : gsub(/\./, "."); print n "\t" $0 }' | sort -rn | cut -f2)
  for t in ${stale[@]+"${stale[@]}"}; do
    remove_tag "$t"
  done
  for t in ${used[@]+"${used[@]}"}; do
    echo "kept $t: a container uses it (docker ps -a lists them)"
  done
  docker image prune -f --filter label=clod.hash >/dev/null
  (( ${#stale[@]} + ${#used[@]} )) || echo "clod: no stale images"
}

# Prints a row for home $1 (a directory or vol:NAME), labelled $2. A volume's
# logins aren't on the host, so they show as ?.
home_row() {
  local mark=' ' claude=- codex=-
  [[ $1 == "$home" ]] && mark='*'
  if [[ $1 == vol:* ]]; then
    claude='?' codex='?'
  else
    [[ -s $1/.claude/.credentials.json ]] && claude=yes
    [[ -s $1/.codex/auth.json ]] && codex=yes
  fi
  printf '%s %-20s %-7s %s\n' "$mark" "$2" "$claude" "$codex"
}

cmd_home() {
  local d v listed=''
  printf '  %-20s %-7s %s\n' HOME CLAUDE CODEX
  for d in "$clod_dir"/homes/*; do
    [[ -d $d ]] || continue
    home_row "$d" "$(basename "$d")"
    [[ $d == "$home" ]] && listed=1
  done
  # Volume homes, if Docker is up; the name filter matches anywhere in a name.
  while IFS= read -r v; do
    [[ $v == clod-home-* ]] || continue
    home_row "vol:${v#clod-home-}" "vol:${v#clod-home-}"
    [[ vol:${v#clod-home-} == "$home" ]] && listed=1
  done < <(docker volume ls -q --filter name=clod-home- 2>/dev/null)
  [[ -n $listed ]] || home_row "$home" "$home_label"
  echo
  echo "* used here; clod -H NAME uses another, and a new name creates it"
  echo "  (vol:NAME, a Docker volume; ? means its logins can't be checked from here)"
}

# True when a container, running or stopped, uses Docker volume $1, which Docker
# then won't remove.
volume_in_use() {
  [[ -n $(docker ps -aq --filter "volume=$1" 2>/dev/null) ]]
}

# Unless --force, lists $2... as the $1s to delete, and exits unless the answer
# to a y/N question is yes.
confirm_delete() {
  local kind=$1 line answer
  shift
  [[ -n $force ]] && return 0
  if [[ ! -t 0 ]]; then
    echo "clod: there's no terminal to ask in; clod --force $kind rm deletes without asking" >&2
    exit 1
  fi
  echo "clod: deleting, with every file in them:" >&2
  for line; do
    echo "  $line" >&2
  done
  read -r -p "Delete? [y/N] " answer
  case $answer in
    y|Y|yes|YES) ;;
    *) echo "clod: nothing deleted" >&2; exit 1 ;;
  esac
}

# Removes the Docker volumes $1NAME for the names in $3..., volume $2s, once they're listed and, unless --force, the answer to a y/N
# question is yes. Removes none if any isn't one or a container uses it.
remove_volumes() {
  local prefix=$1 kind=$2 name v vols=() lines out
  shift 2
  for name; do
    v=$prefix$name
    is_one_of "$v" "${vols[*]}" && continue
    if [[ ! $name =~ $name_re ]] || ! docker volume inspect "$v" >/dev/null 2>&1; then
      echo "clod: no volume $kind named vol:$name (clod $kind lists them)" >&2
      exit 1
    fi
    if volume_in_use "$v"; then
      echo "clod: a container uses vol:$name, so it can't be removed; docker ps -a lists the containers" >&2
      exit 1
    fi
    vols+=("$v")
  done
  lines=()
  for v in "${vols[@]}"; do
    lines+=("vol:${v#"$prefix"} (Docker volume $v)")
  done
  confirm_delete "$kind" "${lines[@]}"
  for v in "${vols[@]}"; do
    if ! out=$(docker volume rm "$v" 2>&1); then
      echo "clod: can't remove $v: $out" >&2
      exit 1
    fi
    echo "removed vol:${v#"$prefix"} ($v)"
  done
}

# True when a container, running or stopped, mounts home $1: a directory or
# vol:NAME. A bind mount's source is matched at its end, in case the Docker
# reports it under a prefix of its own.
home_in_use() {
  local ids src
  [[ $1 == vol:* ]] && { volume_in_use "clod-home-${1#vol:}"; return; }
  ids=$(docker ps -aq 2>/dev/null)
  [[ -n $ids ]] || return 1
  # shellcheck disable=SC2086 # container ids are words
  while IFS= read -r src; do
    [[ -n $src && ( $src == "$1" || $src == */"${1#/}" ) ]] && return 0
  done < <(docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' $ids 2>/dev/null)
  return 1
}

# Sets REPLY to home $1, resolved, and checks it for clod home cp, mv or rm,
# as the source when $2 is src and otherwise the destination: a source must
# exist and a destination must not, neither can be in use, and a directory
# can't be off limits.
check_home_arg() {
  local h label did
  case $verb in
    cp) did=copied ;;
    mv) did=moved ;;
    *) did=removed ;;
  esac
  resolve_home "home $verb" "$1"
  h=$REPLY
  label=$(tildify "${h#"$clod_dir/homes/"}")
  if [[ $h == vol:* ]]; then
    if docker volume inspect "clod-home-${h#vol:}" >/dev/null 2>&1; then
      [[ $2 == src ]] || { echo "clod: there's already a home $label" >&2; exit 1; }
    else
      [[ $2 != src ]] || { echo "clod: no home $label (clod home lists them)" >&2; exit 1; }
    fi
  else
    if off_limits "$h"; then
      echo "clod: $label can't be $did: clod won't touch /, your home folder, a folder above it, ~/.clod or ~/.clod/homes" >&2
      exit 1
    fi
    if [[ -e $h || -L $h ]]; then
      [[ $2 == src ]] || { echo "clod: $label already exists" >&2; exit 1; }
      [[ -d $h ]] || { echo "clod: $label isn't a directory" >&2; exit 1; }
    else
      [[ $2 != src ]] || { echo "clod: no home $label (clod home lists them)" >&2; exit 1; }
    fi
  fi
  if home_in_use "$h"; then
    echo "clod: a container uses $label, so it can't be $did now; docker ps -a lists the containers" >&2
    exit 1
  fi
  REPLY=$h
}

# Deletes the homes $@, named NAME (in ~/.clod/homes) or vol:NAME. Deletes
# none if any doesn't exist or a container uses it.
cmd_home_rm() {
  local arg h homes=() lines=() i
  realdir "$HOME"; host_home=$REPLY
  realdir "$clod_dir"; clod_real=$REPLY
  for arg; do
    check_home_arg "$arg" src
    h=$REPLY
    for i in ${homes[@]+"${!homes[@]}"}; do
      [[ ${homes[i]} == "$h" ]] && continue 2
    done
    homes+=("$h")
    if [[ $h == vol:* ]]; then
      lines+=("$arg (Docker volume clod-home-${h#vol:})")
    else
      lines+=("$arg (the folder $(tildify "$h"))")
    fi
  done
  confirm_delete home "${lines[@]}"
  for i in "${!homes[@]}"; do
    h=${homes[i]}
    if [[ $h == vol:* ]]; then
      docker volume rm "clod-home-${h#vol:}" >/dev/null || exit 1
    else
      rm -rf "$h" || exit 1
    fi
    echo "removed ${lines[i]}"
  done
}

# Copies home $1 to the new home $2, each a directory or vol:NAME, in a
# container of the clod image. The copy runs as claude, so its files are
# claude's: a new volume is mounted at /workspace, which the image makes
# claude's, so Docker gives the volume that owner, and a new directory is made
# here, as you. A failed copy is removed. rsync -a keeps modes with chmod, where
# cp -a copies ACLs too, which the macOS shared folders refuse ("preserving
# permissions ... No data available").
copy_home() {
  local src=$1 dest=$2 from to
  docker image inspect clod >/dev/null 2>&1 || walk_image clod build
  [[ $src == vol:* ]] && src=clod-home-${src#vol:}
  if [[ $dest == vol:* ]]; then
    dest=clod-home-${dest#vol:}
  else
    mkdir -p "$dest"
  fi
  mount_arg "$src" /from ,readonly; from=$REPLY
  mount_arg "$dest" /workspace; to=$REPLY
  echo "clod: copying..." >&2
  if ! docker run --rm --pull=never --user claude --entrypoint rsync \
      --mount "$from" --mount "$to" clod -a /from/ /workspace/; then
    if [[ $dest == /* ]]; then rm -rf "$dest"; else docker volume rm "$dest" >/dev/null 2>&1; fi
    echo "clod: the copy failed (the message is above), so there's no new home" >&2
    exit 1
  fi
}

# Copies home $1 to a new home $2: a name, a path or vol:NAME.
cmd_home_cp() {
  local src dest
  realdir "$HOME"; host_home=$REPLY
  realdir "$clod_dir"; clod_real=$REPLY
  check_home_arg "$1" src; src=$REPLY
  check_home_arg "$2" dest; dest=$REPLY
  if [[ $src != vol:* && $dest == "$src"/* ]]; then
    echo "clod: can't $verb $1 into itself" >&2
    exit 1
  fi
  if [[ $verb == mv && $src != vol:* && $dest != vol:* ]]; then
    mkdir -p "${dest%/*}"
    mv "$src" "$dest" || exit 1
  else
    copy_home "$src" "$dest"
    if [[ $verb == mv ]]; then
      if [[ $src == vol:* ]]; then
        docker volume rm "clod-home-${src#vol:}" >/dev/null
      else
        rm -rf "$src"
      fi || {
        echo "clod: copied $1 to $2, but couldn't delete $1 (the message is above)" >&2
        exit 1
      }
    fi
  fi
  if [[ $verb == mv ]]; then echo "moved $1 to $2"; else echo "copied $1 to $2"; fi
}

# Moves home $1 to a new home $2, as cp, then deleting $1; a directory moved
# to a directory is renamed.
cmd_home_mv() {
  cmd_home_cp "$@"
}

# Lists the volume workspaces, marking those a container uses.
cmd_workspace() {
  local n names state any_used='' mark
  names=$(volume_names clod-workspace-)
  if [[ -z $names ]]; then
    echo "clod: no volume workspaces; clod -w vol:NAME creates one"
    return 0
  fi
  printf '  %-20s %s\n' WORKSPACE STATE
  for n in $names; do
    mark=' ' state=-
    [[ vol:$n == "$workspace" ]] && mark='*'
    if volume_in_use "clod-workspace-$n"; then
      state='in use' any_used=1
    fi
    printf '%s %-20s %s\n' "$mark" "vol:$n" "$state"
  done
  echo
  echo "* used here; clod -w vol:NAME uses one, and a new name creates it (the"
  echo "  Docker volume clod-workspace-NAME); clod workspace rm NAME deletes one"
  [[ -n $any_used ]] && echo "in use: a container, maybe a stopped one, uses it (docker ps -a), so it can't be removed"
  return 0
}

# Removes the volume workspaces named $@, as NAME or vol:NAME.
cmd_workspace_rm() {
  local name names=()
  for name; do
    names+=("${name#vol:}")
  done
  remove_volumes clod-workspace- workspace "${names[@]}"
}

cmd_shared_new() {
  local target=$clod_dir/shared starter=$script_dir/shared report backup
  if [[ ! -d $starter ]]; then
    echo "clod: there's no starter shared config in $(tildify "$script_dir")" >&2
    exit 1
  fi
  if [[ -e $target && -z $force ]]; then
    # A CLAUDE.md that describes the container repeats the image's container.md.
    if grep -qs "started by the user's \`clod\` launcher" "$target/CLAUDE.md"; then
      echo "clod: $(tildify "$target/CLAUDE.md") describes the container, which the image already does; remove that section"
    fi
    # Compares the starter's files with yours; files only you have aren't listed.
    report=$(cd "$starter" && find . -type f | sort | while IFS= read -r f; do
      f=${f#./}
      if [[ ! -f $target/$f ]]; then
        printf '  missing    %s\n' "$f"
      elif ! cmp -s "$f" "$target/$f"; then
        printf '  different  %s\n' "$f"
      fi
    done)
    if [[ -z $report ]]; then
      echo "clod: $(tildify "$target") has everything in the starter, unchanged"
      return 0
    fi
    echo "clod: $(tildify "$target") already exists. Compared with the starter in $(tildify "$starter"):"
    echo "$report"
    echo "See the differences: clod shared diff"
    echo "Replace yours with the starter (yours is kept as a backup): clod --force shared new"
    return 0
  fi
  mkdir -p "$clod_dir"
  if [[ -e $target ]]; then
    backup=$target.bak-$(date +%Y%m%d-%H%M%S)
    mv "$target" "$backup"
    echo "clod: moved your shared config to $(tildify "$backup")"
  fi
  cp -R "$starter" "$target"
  echo "clod: created $(tildify "$target") from $(tildify "$starter")"
  echo "Edit the files there; every clod from now on mounts it instead of the starter."
}

# Shows the differences between the starter shared config and ~/.clod/shared.
cmd_shared_diff() {
  local target=$clod_dir/shared starter=$script_dir/shared
  if [[ ! -d $starter ]]; then
    echo "clod: there's no starter shared config in $(tildify "$script_dir")" >&2
    exit 1
  fi
  if [[ ! -d $target ]]; then
    echo "clod: there's no $(tildify "$target"), so clod uses the starter; clod shared new creates it" >&2
    exit 1
  fi
  local status=0
  diff -ru "$starter" "$target" || status=$?
  (( status == 0 )) && echo "clod: $(tildify "$target") is the same as the starter"
  return "$status"
}

cmd_image_new() {
  local name=$1 from=$2 target src='' combo='' variants from_lines
  [[ $name =~ $name_re ]] || usage_error "invalid image name '$name'"
  target=$clod_dir/images/$name
  if [[ -e $target ]]; then
    echo "clod: $(tildify "$target") already exists" >&2
    exit 1
  fi
  if [[ -n $from ]]; then
    resolve_variant "$from"
    [[ $REPLY == clod-*.* ]] && combo=$REPLY
    find_variant "$from"
    src=$REPLY
    if [[ -z $src && -z $combo ]]; then
      echo "clod: no variant named '$from' (clod image lists them)" >&2
      exit 1
    fi
  elif [[ -f $script_dir/images/$name/Dockerfile ]]; then
    src=$script_dir/images/$name
  fi
  mkdir -p "$clod_dir/images"
  if [[ -n $src ]]; then
    cp -R "$src" "$target"
    echo "clod: created $(tildify "$target") from $(tildify "$src")"
  else
    mkdir "$target"
    if [[ -n $combo ]]; then
      variants=${combo#clod-}
      from_lines="# Built as clod-$name and run with \`clod -i $name\`. It rebuilds whenever a
# file in this directory or in ${variants//./, } changes.
FROM $combo"
    else
      from_lines="# Built as clod-$name and run with \`clod -i $name\`. It rebuilds whenever a
# file in this directory or the image it is FROM changes. BASE lets it go on top
# of another variant, as in \`clod -i go+$name\`.
ARG BASE=clod
FROM \$BASE"
    fi
    cat > "$target/Dockerfile" <<STARTER
$from_lines
USER root
# RUN apt-get install -y postgresql-client
USER claude
# Instructions for Claude about this image, from a CLAUDE.md beside this file:
# COPY CLAUDE.md /etc/clod/.claude/rules/$name.md
STARTER
    echo "clod: created $(tildify "$target") with a starter Dockerfile${combo:+, FROM $combo}"
  fi
  echo "Edit $(tildify "$target")/Dockerfile, then run it with: clod -i $name"
}

# Prints a line of clod env: field $1 with value $2.
field() { printf '%-11s%s\n' "$1:" "$2"; }

cmd_env() {
  local home_path parts p from shown
  home_path=$(tildify "$home")
  if [[ $home == vol:* ]]; then
    field home "$home_label (Docker volume $home_src)"
  elif [[ $home_label == "$home_path" ]]; then
    field home "$home_label"
  else
    field home "$home_label ($home_path)"
  fi
  if [[ $tag == clod-*.* ]]; then
    IFS=. read -ra parts <<< "$image"
    from=''
    for p in "${parts[@]}"; do
      find_variant "$p"
      from+="${from:+ + }$(tildify "$REPLY")"
    done
    field image "$tag ($from)"
  else
    field image "$tag${variant_dir:+ ($(tildify "$variant_dir"))}"
  fi
  field command "${CLOD_COMMAND:-claude} (what a bare clod runs)"
  if [[ -n $scratch ]]; then
    field scratch "an empty /workspace, discarded on exit"
  elif [[ $workspace == vol:* ]]; then
    field workspace "$workspace_label (Docker volume $workspace_src)"
  else
    field workspace "$workspace_label"
  fi
  field tz "${tz:-UTC}"
  [[ -n $envrc ]] && field envrc "$(tildify "$envrc")"
  [[ $OSTYPE == linux* ]] && field user "claude as $(id -u):$(id -g)"
  [[ -n $shared_dir ]] && field shared "$(tildify "$shared_dir")"
  if (( ${#port_args[@]} )); then
    shown=''
    for p in "${port_args[@]}"; do
      [[ $p == -p ]] || shown+="${shown:+, }${p%:*} → ${p##*:}"
    done
    field ports "$shown"
  fi
  [[ -n $docker_socket ]] && field docker "the host's Docker socket (root on the Docker host)"
  [[ -f $config ]] && field config "$(tildify "$config")"
  (( ${#vars[@]} )) && printf '%s\n' "${vars[@]}"
  return 0
}

# image build and image rebuild: builds the images named $@ (as for -i), or
# with none named the image -i selects, and the clod images they are FROM, those
# that are stale or, for rebuild, all of them. Each image is built once, however
# many of the named ones are built on it.
cmd_image_build() {
  local name tags=() t
  (( $# )) || set -- "$image"
  for name; do
    if [[ $name == clod ]]; then
      t=clod
    else
      resolve_variant "$name"
      t=$REPLY
    fi
    if [[ -z $t ]]; then
      echo "clod: $name is not a clod image or variant, so there is nothing to $verb" >&2
      exit 1
    fi
    tags+=("$t")
  done
  for t in "${tags[@]}"; do
    walk_image "$t" build
  done
  if [[ -n $built ]]; then
    docker image prune -f --filter label=clod.hash >/dev/null
  else
    for t in "${tags[@]}"; do
      echo "clod: ${t#clod-} is up to date"
    done
  fi
}

# Sets REPLY to the --mount value that mounts $1, a host directory (an absolute
# path) or a Docker volume, at $2, with options $3 (such as ",readonly"). Unlike
# -v, a bind --mount fails when Docker can't see the directory (outside
# Colima's shared folders, say) instead of mounting an empty one it creates.
# The source is CSV-quoted, since commas separate the fields.
mount_arg() {
  local type=volume
  [[ $1 == /* ]] && type=bind
  REPLY="type=$type,\"src=${1//\"/\"\"}\",dst=$2$3"
}

# Runs command $command with arguments $@ in the container, building its image
# first if needed.
cmd_run() {
  local run_args variants endpoint sock mount probe sock_stat
  # Docker creates a missing volume, copying the image's /home/claude into it.
  [[ $home == vol:* ]] || mkdir -p "$home"

  if [[ -n $skip_build ]] && docker image inspect "$tag" >/dev/null 2>&1; then
    echo "clod: running $tag as built" >&2
  elif [[ $tag == clod || -n $variant_dir ]]; then
    walk_image "$tag" build
  elif ! docker image inspect "$tag" >/dev/null 2>&1; then
    variants=$(variant_names | tr '\n' ' ')
    echo "clod: no variant or local image named '$image'${variants:+ (variants: ${variants% })}" >&2
    exit 1
  fi
  # Images replaced by a build are left untagged; remove them.
  [[ -n $built ]] && docker image prune -f --filter label=clod.hash >/dev/null

  mount_arg "$home_src" /home/claude
  run_args=(-i --mount "$REPLY" -e "CLOD_HOME=$home_label" -e "CLOD_IMAGE=$tag")
  # A scratch workspace is an anonymous volume, which --rm removes. Docker
  # copies the image's /workspace into it, owned by claude.
  # A volume workspace, like a volume home, starts as a copy of it.
  if [[ -n $scratch ]]; then
    run_args+=(-v /workspace -e CLOD_SCRATCH=1)
  else
    mount_arg "$workspace_src" /workspace
    run_args+=(--mount "$REPLY" -e "CLOD_WORKSPACE=$workspace_label")
  fi
  [[ -n $tz ]] && run_args+=(-e "TZ=$tz")
  if (( ${#port_args[@]} )); then
    run_args+=("${port_args[@]}" -e "CLOD_PORTS=$(IFS=,; echo "${container_ports[*]}")")
  fi
  if [[ -n $shared_dir ]]; then
    mount_arg "$shared_dir" /etc/claude-code ,readonly
    run_args+=(--mount "$REPLY")
  fi
  # Docker Engine on Linux has no built-in host.docker.internal.
  [[ $OSTYPE == linux* ]] && run_args+=(--add-host=host.docker.internal:host-gateway)
  # --docker mounts the socket of the Docker that runs clod, which must be local:
  # the path is the same on Linux, in Colima's VM and in Docker Desktop's. The
  # socket's group, as a container sees it, lets claude use it. --mount, unlike
  # -v, fails rather than creating a missing source. The same throwaway container
  # checks the image has the docker CLI.
  if [[ -n $docker_socket ]]; then
    endpoint=${DOCKER_HOST:-$(docker context inspect -f '{{.Endpoints.docker.Host}}' 2>/dev/null)}
    case $endpoint in
      ''|unix://*) ;;
      *)
        echo "clod: --docker needs a local Docker, but it's at $endpoint" >&2
        exit 1
        ;;
    esac
    sock=/var/run/docker.sock
    mount=(--mount "type=bind,src=$sock,dst=$sock")
    # shellcheck disable=SC2016 # the quoted script runs in the container
    probe=$(docker run --rm --pull=never "${mount[@]}" --entrypoint sh "$tag" \
      -c 'stat -c "%F %g" "$1" && { command -v docker >/dev/null || echo no-cli; }' sh "$sock" 2>&1)
    sock_stat=${probe%%$'\n'*}
    if [[ ! $sock_stat =~ ^socket\ [0-9]+$ ]]; then
      echo "clod: --docker: can't find Docker's socket at $sock on the Docker host: $probe" >&2
      exit 1
    fi
    if [[ $probe == *no-cli ]]; then
      echo "clod: --docker: $tag has no docker CLI, so only the socket is there; the docker variant has it (clod -i docker --docker)" >&2
    fi
    run_args+=("${mount[@]}" --group-add "${sock_stat#socket }")
    # A volume workspace has no path on the Docker host.
    [[ -n $workspace && $workspace != vol:* ]] && run_args+=(-e "CLOD_HOST_WORKSPACE=$workspace")
  fi
  # In a terminal, the host terminal's name, version and colour support go in
  # too, so programs inside can tell what it supports, such as links. TERM
  # stays Docker's xterm: the container may lack the host's terminfo entry.
  if [[ -t 0 && -t 1 ]]; then
    run_args+=(-t)
    for v in TERM_PROGRAM TERM_PROGRAM_VERSION LC_TERMINAL LC_TERMINAL_VERSION COLORTERM; do
      [[ -n ${!v:-} ]] && run_args+=(-e "$v")
    done
  fi
  echo "clod · $home_label · $tag · ${#vars[@]} vars${workspace_opt:+ · $workspace_label}${scratch:+ · scratch}${docker_socket:+ · Docker socket}" >&2
  # Images are local: clod builds them, so a mistyped name must not pull one.
  exec docker run --rm --pull=never --env-file <(printf '%s\n' ${vars[@]+"${vars[@]}"}) "${run_args[@]}" "$tag" "$command" "$@"
}

# The dispatch. install, update and completion run before the envrc is read, and default
# before the settings it edits are resolved, so a broken one can be fixed with
# it. The rest run once the home, image and ports are settled. Only a run and
# the commands that change images or volumes, or list volume workspaces, check
# that Docker is up, and only a run refuses mounts holding secrets.
# The shell's tab completion runs __complete, which takes no options and reads
# no settings.
if [[ $1 == __complete ]]; then
  shift
  cmd_complete "$@"
  exit
fi
parse_args "$@"
set -- ${args[@]+"${args[@]}"}
case $command in
  install|update|completion) "cmd_$command" "$@"; exit 0 ;;
esac
setup_workspace
load_settings
[[ $command == default ]] && { cmd_default "$@"; exit 0; }
[[ -n $command ]] || default_command
setup_home
setup_image
setup_container
case $command${verb:+ $verb} in
  env) check_workspace; cmd_env; exit 0 ;;
  image|'image show'|'image new'|home|'shared new')
    "cmd_$command${verb:+_$verb}" "$@"; exit 0 ;;
  # diff's status: 1 when they differ.
  'shared diff') cmd_shared_diff; exit ;;
  'image build'|'image rebuild') need_docker; cmd_image_build "$@"; exit 0 ;;
  'image '*|'home '*|workspace*) need_docker; "cmd_$command${verb:+_$verb}" "$@"; exit 0 ;;
esac
check_workspace
refuse_off_limits
need_docker
cmd_run "$@"

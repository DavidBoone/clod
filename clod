#!/bin/bash
# clod: run Claude Code, Codex or a shell in a throwaway Docker container on the
# current directory. `clod --help` describes the commands and options.
#
# clod refuses to mount your home directory, a directory above it, ~/.clod or
# anything under ~/.clod/homes as /workspace, since the agent could then read
# your credentials and every home's login.
#
# Launcher settings come from the command line (-i, -H, -c, -p) or else the
# calling shell's environment:
#
#   CLOD_HOME   container home: a name (~/.clod/homes/<name>) or, if it contains a
#               slash, a host path relative to the current directory (default: default)
#   CLOD_IMAGE  image to run (default clod): a variant name, built from
#               ~/.clod/images/<name>/ or else this script's images/<name>/ as
#               clod-<name>, or any local docker image
#   CLOD_CREDS  borrow another home's Claude login (name or path, as CLOD_HOME);
#               unset = the home keeps its own
#   CLOD_COMMAND  command a bare `clod` (or `clod -- ARGS`) runs: claude
#               (default), codex, bash or zsh
#   CLOD_PORTS  ports to publish on the host's 127.0.0.1, comma- or
#               space-separated: 8080 (the same on both sides) or host:container
#               (an address first, as in docker run -p, publishes there instead)
#
# The envrc (below) can set these too, as defaults for the shell's, and
# ~/.clod/config (NAME=value lines, written by `clod default KEY VALUE`) as
# defaults for both.
#
# The clod image is built from this script's directory, and a variant from its
# directory, whenever their files (or, for a variant, the image it is FROM)
# change. A variant can build on another as FROM clod-<name>.
#
# ~/.clod/shared is mounted read-only as /etc/claude-code, where Claude Code
# reads managed settings and CLAUDE.md for every home. Until you create it, the
# starter set in this script's shared/ directory is mounted instead.
#
# Inside the container, CLOD_HOME, CLOD_IMAGE and (when borrowed) CLOD_CREDS
# hold the home label, image tag and login source this run resolved to, and
# CLOD_PORTS the published container ports.
#
# On a Linux host the clod image's claude user is built with the host user's
# uid and gid, and host.docker.internal is mapped to the host.
#
# The nearest .clod.envrc or .envrc, looking up from the current directory, is
# evaluated on the host and the variables it sets are passed into the container.
# In each directory .clod.envrc wins over .envrc. A .clod.envrc is sourced in
# bash with set -a and direnv's stdlib when direnv is installed; an .envrc is
# loaded by direnv itself, so it must be allowed and only exports count.
# Launcher settings it sets are used, not passed in.

# Written for bash 3.2, the /bin/bash macOS ships.

# This script's directory, found by following symlinks to it (macOS readlink
# has no -f before 12.3), holds the base image's files, the bundled variants
# and the starter shared config.
script=$0
while [[ -L $script ]]; do
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
script_dir=$(cd "$(dirname "$script")" && pwd -P)
base_dir=$script_dir
[[ -f $base_dir/Dockerfile ]] || base_dir=

# Prints clod's version: its checkout's commit, or a tag when there is one.
clod_version() {
  git -C "$script_dir" describe --tags --always --dirty 2>/dev/null || echo unknown
}

usage() {
  cat <<'USAGE'
Usage: clod [options] [command] [args...]

Runs an agent or a shell in a throwaway container on the current directory.

Commands:
  claude [args]          Claude Code
  codex [args]           Codex
  bash|zsh [args]        a shell in the container
  env                    show the home, image, login, ports, envrc and variables
  images                 list the base image and the variants
  homes                  list the homes and their logins
  new-image NAME [FROM]  create ~/.clod/images/NAME as a copy of variant FROM,
                         of the bundled variant NAME, or as a starter
  default [KEY [VALUE]]  show or set your defaults: image, command, home,
                         creds, ports (VALUE --reset removes one)
  rebuild                rebuild the image and its bases from scratch
  update                 update clod itself (git pull in its checkout)
  install [DIR]          link clod into DIR, or a directory on your PATH

Options (before the command):
  -i, --image NAME       image or variant to run            (CLOD_IMAGE)
  -H, --home NAME|PATH   container home                     (CLOD_HOME)
  -c, --creds HOME       borrow another home's login        (CLOD_CREDS)
  -p, --port PORT        publish a port on localhost; repeatable (CLOD_PORTS)
                           -p 5173       localhost:5173 -> container port 5173
                           -p 3000:5173  localhost:3000 -> container port 5173
  -f, --force            run from a directory clod otherwise refuses
      --skip-build       run the image as built, even if its files have changed
  -h, --help             show this help
      --version          show clod's version
  --                     end of options: the rest goes to the default command

With no command, clod runs the default command: claude, unless CLOD_COMMAND
or `clod default command` says otherwise. A command's own args go after it,
unchanged, options included.

Examples:
  clod                     Claude Code
  clod -- --resume         Claude Code with its own arguments
  clod -i go -p 5173       the go variant, with port 5173 published
  clod -H work codex       Codex in the "work" home
USAGE
}

# Exits with error message $1 and a pointer to --help.
usage_error() {
  echo "clod: $1 (see clod --help)" >&2
  exit 2
}

force='' skip_build='' command='' dashdash=''
opt_image='' opt_home='' opt_creds='' opt_ports=()
while (( $# )); do
  case $1 in
    -i|--image|-H|--home|-c|--creds|-p|--port)
      [[ $# -ge 2 ]] || usage_error "$1 needs a value"
      case $1 in
        -i|--image) opt_image=$2 ;;
        -H|--home) opt_home=$2 ;;
        -c|--creds) opt_creds=$2 ;;
        -p|--port) opt_ports+=("$2") ;;
      esac
      shift 2
      ;;
    --image=*) opt_image=${1#*=}; shift ;;
    --home=*) opt_home=${1#*=}; shift ;;
    --creds=*) opt_creds=${1#*=}; shift ;;
    --port=*) opt_ports+=("${1#*=}"); shift ;;
    -f|--force) force=1; shift ;;
    --skip-build) skip_build=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --version)
      echo "clod $(clod_version)"
      exit 0
      ;;
    --) shift; dashdash=1; break ;;
    -*) usage_error "unknown option $1; a command's own options go after it, or after --" ;;
    *) break ;;
  esac
done
if [[ -z $dashdash && $# -gt 0 ]]; then
  case $1 in
    claude|codex|bash|zsh|env|images|homes|new-image|default|rebuild|update|install)
      command=$1
      shift
      ;;
    *) usage_error "unknown command '$1'; the default command's args go after --" ;;
  esac
fi
# Options win over the environment, the envrc and ~/.clod/config.
[[ -n $opt_image ]] && CLOD_IMAGE=$opt_image
[[ -n $opt_home ]] && CLOD_HOME=$opt_home
[[ -n $opt_creds ]] && CLOD_CREDS=$opt_creds
(( ${#opt_ports[@]} )) && CLOD_PORTS="${opt_ports[*]}"

name_re='^[A-Za-z0-9_-]+$'
port_re='^([0-9.]+:|\[[0-9a-fA-F:]+\]:)?([0-9]+:)?[0-9]+(/(tcp|udp))?$'

# Prints path $1 with a leading $HOME shown as ~.
tildify() {
  case $1 in
    "$HOME"|"$HOME"/*) printf '%s\n' "~${1#"$HOME"}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Sets REPLY to path $1 made absolute against $PWD, with . and .. resolved but
# symlinks kept; the path need not exist.
abspath() {
  local p=$1 part out=() parts
  [[ $p == /* ]] || p=$PWD/$p
  IFS=/ read -ra parts <<< "$p"
  for part in "${parts[@]}"; do
    case $part in
      ''|.) ;;
      ..) (( ${#out[@]} )) && unset "out[$(( ${#out[@]} - 1 ))]" ;;
      *) out+=("$part") ;;
    esac
  done
  REPLY=
  for part in "${out[@]}"; do REPLY+=/$part; done
  [[ -n $REPLY ]] || REPLY=/
}

# Prints directory $1 with symlinks resolved, or $1 itself if it doesn't exist.
realdir() {
  (cd "$1" 2>/dev/null && pwd -P) || printf '%s\n' "$1"
}

# Sets REPLY to the nearest .clod.envrc or .envrc from $PWD up, or to nothing.
find_envrc() {
  local dir=$PWD
  REPLY=
  while :; do
    [[ -f $dir/.clod.envrc ]] && { REPLY=$dir/.clod.envrc; return; }
    [[ -f $dir/.envrc ]] && { REPLY=$dir/.envrc; return; }
    [[ $dir == / ]] && return
    dir=${dir%/*}
    [[ -n $dir ]] || dir=/
  done
}

# Prints the variables envrc file $1 sets, as NAME=value lines. Host-only
# variables (PATH, terminal size, direnv's own) are left out, and multi-line
# ones, which --env-file can't carry, are skipped with a warning.
envrc_vars() {
  local clean=(env -i HOME="$HOME" PATH="$PATH" DIRENV_LOG_FORMAT=) base out
  local dump='BEGIN {
    for (k in ENVIRON) {
      if (k !~ /^[A-Za-z_][A-Za-z0-9_]*$/) continue
      if (ENVIRON[k] ~ /\n/) print "clod: skipping multi-line variable " k > "/dev/stderr"
      else print k "=" ENVIRON[k]
    }
  }'
  [[ -n $XDG_CONFIG_HOME ]] && clean+=(XDG_CONFIG_HOME="$XDG_CONFIG_HOME")
  [[ -n $XDG_DATA_HOME ]] && clean+=(XDG_DATA_HOME="$XDG_DATA_HOME")
  base=$("${clean[@]}" awk "$dump")
  if [[ $1 == */.clod.envrc ]]; then
    # shellcheck disable=SC2016 # the script expands its own arguments
    out=$("${clean[@]}" bash -c '
      command -v direnv >/dev/null && eval "$(direnv stdlib)"
      cd "${1%/*}" || exit
      set -a
      . "$1"
      set +a
      awk "$2"
    ' _ "$1" "$dump") || { echo "clod: $(tildify "$1") failed" >&2; return 1; }
  elif command -v direnv >/dev/null; then
    out=$("${clean[@]}" direnv exec "$(dirname "$1")" awk "$dump") ||
      { echo "clod: run 'direnv allow' to use $(tildify "$1"), or add a .clod.envrc beside it" >&2; return 1; }
  else
    echo "clod: ignoring $(tildify "$1"): direnv is not installed" >&2
    return 0
  fi
  printf '%s\n' "$out" | grep -vxF -f <(printf '%s\n' "$base") |
    grep -vE '^(PATH|PWD|OLDPWD|SHLVL|_|LINES|COLUMNS|DIRENV_[A-Z_]*)=' | sort
  return 0
}

if [[ $command == install ]]; then
  target=$script_dir/clod
  if [[ -n $1 ]]; then
    dir=$1
  else
    # The first of these on PATH that you can write to, else ~/.local/bin.
    dir=''
    for d in "$HOME/.local/bin" "$HOME/bin" /opt/homebrew/bin /usr/local/bin; do
      case ":$PATH:" in
        *":$d:"*) if [[ -d $d && -w $d ]]; then dir=$d; break; fi ;;
      esac
    done
    [[ -n $dir ]] || dir=$HOME/.local/bin
  fi
  link=$dir/clod
  if [[ -L $link && $(readlink "$link") == "$target" ]]; then
    echo "clod is already installed as $(tildify "$link")"
  elif [[ -e $link || -L $link ]] && [[ -z $force ]]; then
    echo "clod: $(tildify "$link") already exists; clod --force install replaces it" >&2
    exit 1
  else
    mkdir -p "$dir" && ln -sfn "$target" "$link" || exit 1
    echo "clod: installed $(tildify "$link") -> $(tildify "$target")"
  fi
  case ":$PATH:" in
    *":$dir:"*) ;;
    *)
      case ${SHELL##*/} in
        zsh) rc=$(tildify "$HOME/.zshrc") ;;
        bash) if [[ $OSTYPE == darwin* ]]; then rc=$(tildify "$HOME/.bash_profile"); else rc=$(tildify "$HOME/.bashrc"); fi ;;
        *) rc='your shell startup file' ;;
      esac
      echo
      echo "$(tildify "$dir") isn't on your PATH. Add this line to $rc, then open a new terminal:"
      echo "  export PATH=\"${dir/#$HOME/\$HOME}:\$PATH\""
      ;;
  esac
  exit 0
fi

if [[ $command == update ]]; then
  if ! git -C "$script_dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "clod: $(tildify "$script_dir") isn't a git checkout, so there's nothing to update" >&2
    exit 1
  fi
  before=$(git -C "$script_dir" rev-parse HEAD)
  if ! git -C "$script_dir" pull --ff-only --quiet; then
    echo "clod: couldn't fast-forward $(tildify "$script_dir"); update it with git there" >&2
    exit 1
  fi
  after=$(git -C "$script_dir" rev-parse HEAD)
  if [[ $before == "$after" ]]; then
    echo "clod $(clod_version) is up to date"
    exit 0
  fi
  # One line per change: --first-parent shows a merged pull request as its
  # merge commit rather than every commit inside it.
  count=$(git -C "$script_dir" rev-list --first-parent --count "$before..$after")
  echo "clod updated to $(clod_version), $count change$([[ $count == 1 ]] || echo s):"
  git -C "$script_dir" log --first-parent --no-decorate --format='  %h %s' -n 20 "$before..$after"
  if (( count > 20 )); then
    echo "  ... and $((count - 20)) more: git -C $(tildify "$script_dir") log"
  fi
  exit 0
fi

find_envrc
envrc=$REPLY
vars=()
if [[ -n $envrc ]]; then
  out=$(envrc_vars "$envrc") || exit 1
  while IFS= read -r line; do
    [[ -n $line ]] && vars+=("$line")
  done <<< "$out"
fi
# Launcher settings from the envrc are defaults for the shell's, not container
# variables.
container_vars=()
for v in ${vars[@]+"${vars[@]}"}; do
  case $v in
    CLOD_HOME=*|CLOD_IMAGE=*|CLOD_CREDS=*|CLOD_PORTS=*|CLOD_COMMAND=*)
      name=${v%%=*}
      [[ -n ${!name} ]] || printf -v "$name" '%s' "${v#*=}"
      ;;
    *) container_vars+=("$v") ;;
  esac
done
vars=(${container_vars[@]+"${container_vars[@]}"})

clod_dir=$HOME/.clod
config=$clod_dir/config
# ~/.clod/config holds launcher settings as NAME=value lines, defaults for both
# the shell's and the envrc's.
if [[ -f $config ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      CLOD_HOME=*|CLOD_IMAGE=*|CLOD_CREDS=*|CLOD_PORTS=*|CLOD_COMMAND=*)
        name=${line%%=*}
        [[ -n ${!name} ]] || printf -v "$name" '%s' "${line#*=}"
        ;;
    esac
  done < "$config"
fi
command -v shasum >/dev/null && sum=shasum || sum=sha1sum

# Docker Engine on Linux keeps bind-mount ownership as is, so claude gets the
# host user's ids there.
base_args=()
[[ $OSTYPE == linux* ]] &&
  base_args=(--build-arg "CLOD_UID=$(id -u)" --build-arg "CLOD_GID=$(id -g)")

# Resolves a CLOD_HOME-style value ($2, named $1 in errors) into $REPLY.
resolve_home() {
  if [[ $2 == */* ]]; then
    abspath "$2"
  elif [[ $2 =~ $name_re ]]; then
    REPLY=$clod_dir/homes/$2
  else
    echo "clod: invalid $1 name '$2' (use ./$2 for a path)" >&2
    exit 1
  fi
}

# Sets REPLY to the directory of variant $1, from ~/.clod/images or else this
# script's images/, or to nothing if there is none.
find_variant() {
  local d
  REPLY=
  [[ $1 =~ $name_re ]] || return 0
  for d in "$clod_dir/images/$1" "$script_dir/images/$1"; do
    if [[ -f $d/Dockerfile ]]; then
      REPLY=$d
      return 0
    fi
  done
}

# `clod default`: shows and edits the launcher settings in ~/.clod/config.
# Prints the variable and built-in value of setting $1, or fails.
setting_of() {
  case $1 in
    image) echo "CLOD_IMAGE clod" ;;
    command) echo "CLOD_COMMAND claude" ;;
    home) echo "CLOD_HOME default" ;;
    creds) echo "CLOD_CREDS -" ;;
    ports) echo "CLOD_PORTS -" ;;
    *) return 1 ;;
  esac
}
# Prints setting $1 with its value in the config file, or its built-in value.
show_setting() {
  local var builtin value
  read -r var builtin <<< "$(setting_of "$1")"
  value=$(sed -n "s/^$var=//p" "$config" 2>/dev/null | tail -1)
  if [[ -n $value ]]; then
    printf '%-8s %-14s (%s)\n' "$1" "$value" "$(tildify "$config")"
  else
    printf '%-8s %-14s (built in)\n' "$1" "$builtin"
  fi
}
if [[ $command == default ]]; then
  keys='image command home creds ports'
  if [[ $# -eq 0 ]]; then
    for k in $keys; do show_setting "$k"; done
    echo
    echo "clod default KEY VALUE sets one; clod default KEY --reset removes it"
    exit 0
  fi
  key=$1 value=$2
  setting_of "$key" >/dev/null || usage_error "unknown setting '$key' (one of: ${keys// /, })"
  if [[ $# -eq 1 ]]; then
    show_setting "$key"
    exit 0
  fi
  [[ $# -eq 2 ]] || usage_error "default takes a setting and one value"
  read -r var builtin <<< "$(setting_of "$key")"
  [[ $value == --reset || $value == "$builtin" ]] && value=''
  if [[ -n $value ]]; then
    case $key in
      image)
        find_variant "$value"
        if [[ -z $REPLY ]] && ! docker image inspect "$value" >/dev/null 2>&1; then
          echo "clod: no variant or local image named '$value' (clod images lists them)" >&2
          exit 1
        fi
        ;;
      command)
        case $value in
          claude|codex|bash|zsh) ;;
          *) usage_error "the default command is one of claude, codex, bash, zsh" ;;
        esac
        ;;
      home|creds)
        # A path is stored absolute, since the config applies everywhere.
        resolve_home "$var" "$value"
        [[ $value == */* ]] && value=$REPLY
        ;;
      ports)
        for p in ${value//,/ }; do
          [[ $p =~ $port_re ]] || usage_error "invalid port '$p'"
        done
        ;;
    esac
  fi
  mkdir -p "$clod_dir"
  rest=$(grep -v "^$var=" "$config" 2>/dev/null)
  {
    if [[ -n $rest ]]; then printf '%s\n' "$rest"; fi
    if [[ -n $value ]]; then echo "$var=$value"; fi
  } > "$config.tmp" && mv "$config.tmp" "$config"
  show_setting "$key"
  exit 0
fi

# With no command, the default command runs.
if [[ -z $command ]]; then
  command=${CLOD_COMMAND:-claude}
  case $command in
    claude|codex|bash|zsh) ;;
    *)
      echo "clod: CLOD_COMMAND is '$command'; it must be claude, codex, bash or zsh" >&2
      exit 1
      ;;
  esac
fi

resolve_home CLOD_HOME "${CLOD_HOME:-default}"
home=$REPLY
home_label=$(tildify "${home#"$clod_dir/homes/"}")

image=${CLOD_IMAGE:-clod}

creds=
if [[ -n $CLOD_CREDS ]]; then
  resolve_home CLOD_CREDS "$CLOD_CREDS"
  creds=$REPLY/.claude/.credentials.json
  if [[ ! -s $creds ]]; then
    echo "clod: CLOD_CREDS home has no login yet: $(tildify "$creds")" >&2
    exit 1
  fi
  [[ $REPLY == "$home" ]] && creds=
fi
creds_home=${creds%/.claude/.credentials.json}
creds_label=$(tildify "${creds_home#"$clod_dir/homes/"}")

if [[ $image == *[[:space:]]* ]]; then
  echo "clod: invalid CLOD_IMAGE '$image'" >&2
  exit 1
fi
find_variant "$image"
variant_dir=$REPLY
if [[ -n $variant_dir ]]; then
  tag=clod-$image
else
  tag=$image
fi

shared_dir=$clod_dir/shared
[[ -d $shared_dir ]] || shared_dir=$script_dir/shared
[[ -d $shared_dir ]] || shared_dir=

# Publishes each CLOD_PORTS entry on the host's 127.0.0.1 unless it names an
# address, and collects the container ports for the container's CLOD_PORTS.
port_args=() container_ports=()
for p in ${CLOD_PORTS//,/ }; do
  if [[ ! $p =~ $port_re ]]; then
    echo "clod: invalid CLOD_PORTS entry '$p'" >&2
    exit 1
  fi
  case $p in
    *.*:*|\[*) port_args+=(-p "$p") ;;
    *:*) port_args+=(-p "127.0.0.1:$p") ;;
    *) port_args+=(-p "127.0.0.1:$p:$p") ;;
  esac
  container_ports+=("${p##*:}")
done

tz=${TZ:-$(readlink /etc/localtime 2>/dev/null)}
tz=${tz##*zoneinfo/}

if [[ $command == images ]]; then
  built=$(docker image ls --format '{{.Repository}}' 2>/dev/null | sort -u)
  # Prints a row for image $1, tagged $2, from source $3.
  image_row() {
    local mark=' ' state=-
    [[ $1 == "$image" ]] && mark='*'
    grep -qx "$2" <<< "$built" && state=built
    printf '%s %-12s %-7s %s\n' "$mark" "$1" "$state" "$3"
  }
  printf '  %-12s %-7s %s\n' NAME STATE SOURCE
  image_row clod clod "$(tildify "$script_dir") (base)"
  names=$(for f in "$clod_dir"/images/*/Dockerfile "$script_dir"/images/*/Dockerfile; do
    [[ -f $f ]] && basename "$(dirname "$f")"
  done | sort -u)
  for n in $names; do
    if [[ -f $clod_dir/images/$n/Dockerfile ]]; then
      src=$(tildify "$clod_dir/images/$n")
      [[ -f $script_dir/images/$n/Dockerfile ]] && src="$src (overrides bundled)"
    else
      src=bundled
    fi
    image_row "$n" "clod-$n" "$src"
  done
  echo
  echo "* runs here by default; clod -i NAME runs another"
  exit 0
fi

if [[ $command == homes ]]; then
  # Prints a row for home directory $1, labelled $2.
  home_row() {
    local mark=' ' claude=- codex=-
    [[ $1 == "$home" ]] && mark='*'
    [[ -s $1/.claude/.credentials.json ]] && claude=yes
    [[ -s $1/.codex/auth.json ]] && codex=yes
    printf '%s %-20s %-7s %s\n' "$mark" "$2" "$claude" "$codex"
  }
  printf '  %-20s %-7s %s\n' HOME CLAUDE CODEX
  listed=''
  for d in "$clod_dir"/homes/*; do
    [[ -d $d ]] || continue
    home_row "$d" "$(basename "$d")"
    [[ $d == "$home" ]] && listed=1
  done
  [[ -n $listed ]] || home_row "$home" "$home_label"
  echo
  echo "* used here; clod -H NAME uses another, and a new name creates it"
  exit 0
fi

if [[ $command == new-image ]]; then
  name=$1 from=$2
  [[ -n $name ]] || usage_error "new-image needs a NAME"
  [[ $name =~ $name_re ]] || usage_error "invalid image name '$name'"
  target=$clod_dir/images/$name
  if [[ -e $target ]]; then
    echo "clod: $(tildify "$target") already exists" >&2
    exit 1
  fi
  src=''
  if [[ -n $from ]]; then
    find_variant "$from"
    src=$REPLY
    if [[ -z $src ]]; then
      echo "clod: no variant named '$from' (clod images lists them)" >&2
      exit 1
    fi
  elif [[ -f $script_dir/images/$name/Dockerfile ]]; then
    src=$script_dir/images/$name
  fi
  mkdir -p "$clod_dir/images"
  if [[ -n $src ]]; then
    cp -R "$src" "$target"
    echo "clod: created $(tildify "$target") from $(tildify "$src")"
  else
    mkdir "$target"
    cat > "$target/Dockerfile" <<STARTER
# Built as clod-$name and run with \`clod -i $name\`. It rebuilds whenever a
# file in this directory or the image it is FROM changes.
FROM clod
USER root
# RUN apt-get install -y postgresql-client
USER claude
# Instructions for Claude about this image, from a CLAUDE.md beside this file:
# COPY CLAUDE.md /etc/clod/.claude/rules/$name.md
STARTER
    echo "clod: created $(tildify "$target") with a starter Dockerfile"
  fi
  echo "Edit $(tildify "$target")/Dockerfile, then run it with: clod -i $name"
  exit 0
fi

if [[ $command == env ]]; then
  home_path=$(tildify "$home")
  if [[ $home_label == "$home_path" ]]; then
    echo "home:  $home_label"
  else
    echo "home:  $home_label ($home_path)"
  fi
  echo "image: $tag${variant_dir:+ ($(tildify "$variant_dir"))}"
  echo "command: ${CLOD_COMMAND:-claude} (what a bare clod runs)"
  if [[ -n $creds ]]; then
    echo "login: borrowed from $creds_label"
  else
    echo "login: own"
  fi
  echo "tz:    ${tz:-UTC}"
  [[ -n $envrc ]] && echo "envrc: $(tildify "$envrc")"
  [[ $OSTYPE == linux* ]] && echo "user:  claude as $(id -u):$(id -g)"
  [[ -n $shared_dir ]] && echo "shared: $(tildify "$shared_dir")"
  (( ${#port_args[@]} )) && echo "ports: ${port_args[*]}"
  [[ -f $config ]] && echo "config: $(tildify "$config")"
  (( ${#vars[@]} )) && printf '%s\n' "${vars[@]}"
  exit 0
fi

# Builds $1 from directory $2, with any further docker build arguments, unless
# the image is already labelled with hash $3. For `clod rebuild` it always builds,
# without the layer cache.
built='' rebuild=''
[[ $command == rebuild ]] && rebuild=1
build_if_changed() {
  local no_cache=()
  if [[ -n $rebuild ]]; then
    no_cache=(--no-cache)
  else
    [[ $(docker image inspect -f '{{index .Config.Labels "clod.hash"}}' "$1" 2>/dev/null) == "$3" ]] && return
  fi
  echo "clod: building $1..." >&2
  docker build -t "$1" --label "clod.hash=$3" ${no_cache[@]+"${no_cache[@]}"} "${@:4}" "$2" || exit 1
  built=1
}

files_hash() {
  (cd "$1" && find . -type f ! -name '.*' -print0 | sort -z | xargs -0 "$sum") | $sum | cut -d' ' -f1
}

# Builds clod or clod-<variant> $1, first building the clod image it is FROM.
building=()
build_image() {
  local tag=$1 dir parent hash build_args=() b
  for b in ${building[@]+"${building[@]}"}; do
    if [[ $b == "$tag" ]]; then
      echo "clod: image $tag is built FROM itself" >&2
      exit 1
    fi
  done
  building+=("$tag")
  if [[ $tag == clod ]]; then
    [[ -n $base_dir ]] || return 0
    dir=$base_dir
    hash=$( { cat "$dir/Dockerfile" "$dir/entrypoint.sh"; printf '%s\n' "${base_args[*]}"; } | $sum | cut -d' ' -f1)
    build_args=(${base_args[@]+"${base_args[@]}"})
    [[ -n $rebuild ]] && build_args+=(--pull)
  else
    find_variant "${tag#clod-}"
    dir=$REPLY
    parent=$(awk 'toupper($1) == "FROM" { for (i = 2; i <= NF; i++) if ($i !~ /^--/) { print $i; exit } }' "$dir/Dockerfile")
    if [[ $parent == clod ]]; then
      build_image clod
    elif [[ $parent == clod-* ]]; then
      find_variant "${parent#clod-}"
      [[ -n $REPLY ]] && build_image "$parent"
    fi
    hash=$( { docker image inspect -f '{{.Id}}' "$parent" 2>/dev/null; files_hash "$dir"; } | $sum | cut -d' ' -f1)
  fi
  build_if_changed "$tag" "$dir" "$hash" ${build_args[@]+"${build_args[@]}"}
}

if [[ -n $rebuild ]]; then
  if [[ $tag != clod && -z $variant_dir ]]; then
    echo "clod: $tag is not a clod image or variant, so there is nothing to rebuild" >&2
    exit 1
  fi
  build_image "$tag"
  docker image prune -f --filter label=clod.hash >/dev/null
  exit 0
fi

workspace=$(pwd -P) host_home=$(realdir "$HOME") clod_real=$(realdir "$clod_dir")
if [[ -z $force ]] && [[ $workspace == / || $host_home == "$workspace" || $host_home == "$workspace"/* ||
      $workspace == "$clod_real" || $workspace == "$clod_real/homes" || $workspace == "$clod_real/homes"/* ]]; then
  echo "clod: refusing to mount $(tildify "$PWD") as /workspace: it holds your credentials or a home's login (clod --force to run anyway)" >&2
  exit 1
fi

mkdir -p "$home"

if [[ -n $skip_build ]] && docker image inspect "$tag" >/dev/null 2>&1; then
  echo "clod: running $tag as built" >&2
elif [[ $tag == clod || -n $variant_dir ]]; then
  build_image "$tag"
elif ! docker image inspect "$tag" >/dev/null 2>&1; then
  variants=$(for f in "$clod_dir"/images/*/Dockerfile "$script_dir"/images/*/Dockerfile; do
    [[ -f $f ]] && basename "$(dirname "$f")"
  done | sort -u | tr '\n' ' ')
  echo "clod: no variant or local image named '$image'${variants:+ (variants: ${variants% })}" >&2
  exit 1
fi
# Images replaced by a build are left untagged; remove them.
[[ -n $built ]] && docker image prune -f --filter label=clod.hash >/dev/null

# Docker creates a missing mount target as root, which on a Linux host leaves
# the home's .claude unwritable for claude, so the borrowed login's target is
# created here first.
if [[ -n $creds ]]; then
  mkdir -p "$home/.claude"
  [[ -e $home/.claude/.credentials.json ]] || : > "$home/.claude/.credentials.json"
fi

echo "clod · $home_label · $tag · ${#vars[@]} vars" >&2
args=(-i -v "$home:/home/claude" -v "$PWD:/workspace" -e "CLOD_HOME=$home_label" -e "CLOD_IMAGE=$tag")
[[ -n $creds ]] && args+=(-v "$creds:/home/claude/.claude/.credentials.json" -e "CLOD_CREDS=$creds_label")
[[ -n $tz ]] && args+=(-e "TZ=$tz")
if (( ${#port_args[@]} )); then
  args+=("${port_args[@]}" -e "CLOD_PORTS=$(IFS=,; echo "${container_ports[*]}")")
fi
[[ -n $shared_dir ]] && args+=(-v "$shared_dir:/etc/claude-code:ro")
# Docker Engine on Linux has no built-in host.docker.internal.
[[ $OSTYPE == linux* ]] && args+=(--add-host=host.docker.internal:host-gateway)
[[ -t 0 && -t 1 ]] && args+=(-t)
# Images are local: clod builds them, so a mistyped name must not pull one.
exec docker run --rm --pull=never --env-file <(printf '%s\n' ${vars[@]+"${vars[@]}"}) "${args[@]}" "$tag" "$command" "$@"

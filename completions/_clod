#compdef clod
# clod's tab completion for zsh, which loads it from a directory on $fpath,
# where clod install links it. It hands the words to clod __complete, and
# completes file names only when that exits 1.

local -a reply
# A file name after = (--workspace=DIR) is completed from the =.
reply=(${(f)"$(clod __complete "${(@)words[2,CURRENT]}")"}) ||
  { [[ $PREFIX == -*=* ]] && compset -P '*='; _files; return; }
compadd -a reply
